---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ui/ArticleCard.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Pagination from '../../components/ui/Pagination.astro';
import JsonLd from '../../components/ui/JsonLd.astro';
import { getDb } from '../../lib/db/client';
import { generateBreadcrumbJsonLd } from '../../lib/utils/json-ld';
import { getCanonicalUrl } from '../../lib/config/site';
import type { ArticleWithRelations } from '../../lib/db/schema';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404', 302);

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);
if (!dbService) return Astro.redirect('/500', 302);

const category = await dbService.getCategoryBySlug(slug);
if (!category || category.status !== 'active') {
  return Astro.redirect('/404', 302);
}

const url = new URL(Astro.request.url);
const page = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));
const pageSize = 9;
const offset = (page - 1) * pageSize;

const { articles, total } = await dbService.getPublishedArticles({
  categorySlug: slug,
  limit: pageSize,
  offset,
});

const totalPages = Math.ceil(total / pageSize) || 1;
const canonicalUrl = getCanonicalUrl(`/category/${slug}`);

const breadcrumbItems = [
  { name: 'Categories', url: '/' },
  { name: category.name, url: `/category/${slug}` },
];

const breadcrumbSchema = generateBreadcrumbJsonLd(breadcrumbItems);
---

<BaseLayout
  seo={{
    title: `${category.name} — EV Intelligence & Dispatches`,
    description: category.description || `Read automotive reports, powertrain benchmarks, and editorial insights classified under ${category.name}.`,
    canonicalUrl,
  }}
  currentPath={`/category/${slug}`}
>
  <JsonLd schema={breadcrumbSchema} />

  <!-- Taxonomy Masthead -->
  <section class="archive-masthead">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
      <div class="archive-header-inner">
        <span class="archive-kicker">Taxonomy Archive</span>
        <h1 class="archive-title">{category.name}</h1>
        {category.description && (
          <p class="archive-desc">{category.description}</p>
        )}
        <div class="archive-meta">
          <span class="count-pill">{total} {total === 1 ? 'Published Dispatch' : 'Published Dispatches'}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Category Articles Grid -->
  <main class="container archive-main">
    {total === 0 ? (
      <EmptyState
        title={`No dispatches in ${category.name} yet.`}
        message="Our editorial desk has not published dispatches in this category cluster. Reports will appear here once published."
        actionText="Return to Latest Dispatches"
        actionHref="/"
      />
    ) : (
      <>
        <div class="articles-grid-3col">
          {articles.map((art: ArticleWithRelations) => (
            <ArticleCard article={art} variant="standard" />
          ))}
        </div>

        {totalPages > 1 && (
          <div class="pagination-wrapper">
            <Pagination
              currentPage={page}
              totalPages={totalPages}
              baseUrl={`/category/${slug}`}
            />
          </div>
        )}
      </>
    )}
  </main>
</BaseLayout>

<style>
  .archive-masthead {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: clamp(2rem, 4vw, 3.5rem) 0 clamp(1.5rem, 3vw, 2.5rem);
  }

  .archive-header-inner {
    margin-top: 0.75rem;
    max-width: 760px;
  }

  .archive-kicker {
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-electric-accent);
    display: block;
    margin-bottom: 0.5rem;
  }

  .archive-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--color-brand);
    margin-bottom: 0.75rem;
  }

  .archive-desc {
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .count-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.65rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    color: var(--color-text-secondary);
  }

  .archive-main {
    padding: clamp(2.5rem, 5vw, 4rem) 1.5rem clamp(3rem, 6vw, 6rem);
  }

  .articles-grid-3col {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .pagination-wrapper {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .articles-grid-3col {
      grid-template-columns: 1fr;
    }
  }
</style>
