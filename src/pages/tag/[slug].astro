---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ui/ArticleCard.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Pagination from '../../components/ui/Pagination.astro';
import { getDb } from '../../lib/db/client';
import { getCanonicalUrl } from '../../lib/config/site';
import type { ArticleWithRelations } from '../../lib/db/schema';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404', 302);

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);
if (!dbService) return Astro.redirect('/500', 302);

const tagRecord = await runtimeEnv?.DB.prepare('SELECT * FROM tags WHERE slug = ? LIMIT 1').bind(slug).first<{ id: string; name: string; slug: string }>();

if (!tagRecord) {
  return Astro.redirect('/404', 302);
}

const url = new URL(Astro.request.url);
const page = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));
const pageSize = 9;
const offset = (page - 1) * pageSize;

const { articles, total } = await dbService.getPublishedArticles({
  tagSlug: slug,
  limit: pageSize,
  offset,
});

const totalPages = Math.ceil(total / pageSize) || 1;
const canonicalUrl = getCanonicalUrl(`/tag/${slug}`);

const breadcrumbItems = [
  { name: 'Tags', url: '/' },
  { name: `#${tagRecord.name}`, url: `/tag/${slug}` },
];
---

<BaseLayout
  seo={{
    title: `#${tagRecord.name} — Editorial Topic`,
    description: `Published articles and intelligence reports tagged with #${tagRecord.name}.`,
    canonicalUrl,
  }}
  currentPath={`/tag/${slug}`}
>
  <section class="archive-header-section">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
      <div class="header-inner">
        <span class="header-kicker">Topic Tag</span>
        <h1 class="header-title">#{tagRecord.name}</h1>
        <span class="count-badge">{total} {total === 1 ? 'Published Dispatch' : 'Published Dispatches'}</span>
      </div>
    </div>
  </section>

  <main class="container archive-main">
    {total === 0 ? (
      <EmptyState
        title={`No articles tagged #${tagRecord.name} yet.`}
        message="No published dispatches are currently assigned to this keyword."
        actionText="Explore Latest Dispatches"
        actionHref="/"
      />
    ) : (
      <>
        <div class="articles-grid">
          {articles.map((art: ArticleWithRelations) => (
            <ArticleCard article={art} variant="standard" />
          ))}
        </div>

        <Pagination
          currentPage={page}
          totalPages={totalPages}
          baseUrl={`/tag/${slug}`}
        />
      </>
    )}
  </main>
</BaseLayout>

<style>
  .archive-header-section {
    padding: 3.5rem 0 2.5rem;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    max-width: 760px;
  }

  .header-kicker {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-brand-accent);
    display: block;
    margin-bottom: 0.5rem;
  }

  .header-title {
    font-size: 2.75rem;
    letter-spacing: -0.025em;
    margin-bottom: 1rem;
    font-weight: 700;
    font-family: var(--font-mono);
  }

  .count-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    padding: 0.25rem 0.6rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }

  .archive-main {
    padding: 3.5rem 1.5rem 6rem;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 640px) {
    .header-title {
      font-size: 2rem;
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
