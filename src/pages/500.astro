---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  seo={{
    title: '500 — Server Error',
    description: 'An unexpected internal server error occurred.',
    noindex: true,
  }}
>
  <div class="error-wrapper">
    <div class="container-narrow error-content">
      <span class="error-code">500</span>
      <h1 class="error-title">Internal Server Error</h1>
      <p class="error-message">
        An unexpected condition was encountered while processing your request. Server diagnostics have logged the incident.
      </p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary">Return to Homepage</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-wrapper {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 0;
  }

  .error-content {
    text-align: center;
  }

  .error-code {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-danger);
    display: block;
    margin-bottom: 0.5rem;
  }

  .error-title {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .error-message {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 440px;
    margin: 0 auto 2rem;
  }

  .error-actions {
    display: flex;
    justify-content: center;
  }
</style>
