---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ui/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getDb } from '../../lib/db/client';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/', 302);

const dbService = getDb(Astro.locals.runtime?.env);
if (!dbService) return Astro.redirect('/', 302);

const topic = await dbService.getTopicBySlug(slug);
if (!topic) return Astro.redirect('/', 302);

const url = new URL(Astro.request.url);
const page = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));
const pageSize = 12;
const offset = (page - 1) * pageSize;

const { articles, total } = await dbService.listPublishedArticlesByTopic(topic.id, pageSize, offset);
const totalPages = Math.ceil(total / pageSize) || 1;

// Thin Content Protection: Do not index topic pages with 0 published articles
const isThinPage = total === 0;
const robotsDirective = isThinPage ? 'noindex, follow' : 'index, follow';

const breadcrumbs = [
  { name: 'Topics', url: '/' },
  { name: topic.name, url: `/topic/${topic.slug}` },
];
---

<BaseLayout
  title={`${topic.name} — Electric Vehicle Intelligence & News`}
  description={topic.description || `Comprehensive coverage, technical analysis, and reporting on ${topic.name}.`}
  canonicalPath={`/topic/${topic.slug}`}
  robots={robotsDirective}
>
  <div class="topic-page container">
    <Breadcrumbs items={breadcrumbs} />

    <header class="topic-header">
      <div class="topic-badge">Topic Hub</div>
      <h1 class="topic-title">{topic.name}</h1>
      {topic.description && <p class="topic-description">{topic.description}</p>}
      <div class="topic-stats">
        <span>{total} {total === 1 ? 'published article' : 'published articles'}</span>
      </div>
    </header>

    {articles.length === 0 ? (
      <div class="empty-state">
        <p class="empty-title">No published articles under this topic yet.</p>
        <p class="empty-desc">Our editorial team is actively monitoring research sources for verified coverage.</p>
      </div>
    ) : (
      <div class="articles-grid">
        {articles.map((art) => (
          <ArticleCard article={art} />
        ))}
      </div>
    )}

    {totalPages > 1 && (
      <nav class="pagination" aria-label="Topic pagination">
        {page > 1 && (
          <a href={`/topic/${topic.slug}?page=${page - 1}`} class="pagination-link">
            &larr; Previous
          </a>
        )}
        <span class="pagination-info">Page {page} of {totalPages}</span>
        {page < totalPages && (
          <a href={`/topic/${topic.slug}?page=${page + 1}`} class="pagination-link">
            Next &rarr;
          </a>
        )}
      </nav>
    )}
  </div>
</BaseLayout>

<style>
  .topic-page {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .topic-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .topic-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-blue);
    margin-bottom: 0.5rem;
  }

  .topic-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .topic-description {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    max-width: 680px;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .topic-stats {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-dim);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .empty-state {
    padding: 4rem 2rem;
    text-align: center;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .empty-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .empty-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 3rem;
  }

  .pagination-link {
    padding: 0.5rem 1rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-main);
    text-decoration: none;
    font-size: 0.875rem;
  }

  .pagination-info {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
