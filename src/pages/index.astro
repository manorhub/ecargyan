---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ui/ArticleCard.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import JsonLd from '../components/ui/JsonLd.astro';
import { SITE_CONFIG } from '../lib/config/site';
import { getDb } from '../lib/db/client';
import { generateWebSiteJsonLd } from '../lib/utils/json-ld';
import type { ArticleWithRelations, CategoryRecord } from '../lib/db/schema';

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);

let customTagline = SITE_CONFIG.tagline;
let featuredArticle: ArticleWithRelations | null = null;
let secondaryArticles: ArticleWithRelations[] = [];
let latestArticles: ArticleWithRelations[] = [];
let totalArticles = 0;
let categoriesWithArticles: CategoryRecord[] = [];

if (dbService) {
  const [dbTagline, featured, publishedData, activeCategories] = await Promise.all([
    dbService.getSetting('site_tagline'),
    dbService.getFeaturedPublishedArticle(),
    dbService.getPublishedArticles({ limit: 12, offset: 0 }),
    dbService.getActiveCategoriesWithCounts(),
  ]);

  if (dbTagline) customTagline = dbTagline;
  totalArticles = publishedData.total;
  
  const allArticles: ArticleWithRelations[] = publishedData.articles;
  
  if (featured) {
    featuredArticle = featured;
    const remaining = allArticles.filter((a) => a.id !== featured.id);
    secondaryArticles = remaining.slice(0, 3);
    latestArticles = remaining.slice(3);
  } else if (allArticles.length > 0) {
    featuredArticle = allArticles[0];
    secondaryArticles = allArticles.slice(1, 4);
    latestArticles = allArticles.slice(4);
  }

  categoriesWithArticles = activeCategories.filter((c: CategoryRecord) => ((c as any).article_count || 0) > 0);
}

const websiteSchema = generateWebSiteJsonLd();
---

<BaseLayout currentPath="/">
  <JsonLd schema={websiteSchema} />

  <!-- Homepage Editorial Banner / Ticker Header -->
  <section class="lead-banner">
    <div class="container lead-inner">
      <div class="lead-text">
        <span class="lead-kicker">Automotive Intelligence & Fleet Technology</span>
        <h1 class="lead-heading">{SITE_CONFIG.name}</h1>
        <p class="lead-deck">{customTagline}</p>
      </div>
      <div class="lead-meta-pill">
        <span class="pulse-dot"></span>
        <span>{totalArticles} Published Dispatches</span>
      </div>
    </div>
  </section>

  <div class="container main-editorial-wrapper">
    {totalArticles === 0 ? (
      <section class="empty-section">
        <EmptyState
          title="No dispatches published yet."
          message="Our editorial desk is analyzing electric vehicle architectures, battery technology patents, and fleet infrastructure."
        />
      </section>
    ) : (
      <>
        <!-- 1. Editorial Hero Split: Dominant Story + 3 Secondary Dispatches -->
        <section class="hero-split-section" aria-label="Featured Stories">
          <div class="hero-split-grid">
            <div class="hero-lead-col">
              {featuredArticle && (
                <ArticleCard article={featuredArticle} variant="hero" priorityImage={true} />
              )}
            </div>

            {secondaryArticles.length > 0 && (
              <aside class="hero-secondary-col" aria-label="Top Dispatches">
                <div class="secondary-header">
                  <span class="secondary-title">Top Intelligence</span>
                </div>
                <div class="secondary-list">
                  {secondaryArticles.map((art) => (
                    <ArticleCard article={art} variant="compact" />
                  ))}
                </div>
              </aside>
            )}
          </div>
        </section>

        <!-- 2. Latest Chronological Dispatches Grid -->
        {latestArticles.length > 0 && (
          <section class="latest-feed-section" aria-label="Latest Dispatches">
            <div class="section-header">
              <h2 class="section-title">Latest Dispatches</h2>
              <a href="/search" class="section-link">View Full Archive &rarr;</a>
            </div>

            <div class="articles-grid-3col">
              {latestArticles.map((article: ArticleWithRelations) => (
                <ArticleCard article={article} variant="standard" />
              ))}
            </div>
          </section>
        )}

        <!-- 3. Taxonomy Navigation Strip -->
        {categoriesWithArticles.length > 0 && (
          <section class="taxonomy-browse-section">
            <div class="section-header">
              <h2 class="section-title">Explore by Domain</h2>
            </div>
            <div class="taxonomy-chips-grid">
              {categoriesWithArticles.map((cat: CategoryRecord) => (
                <a href={`/category/${cat.slug}`} class="taxonomy-card">
                  <div class="tax-card-main">
                    <span class="tax-name">{cat.name}</span>
                    <span class="tax-desc">{cat.description || 'View technical dispatches & reports'}</span>
                  </div>
                  <div class="tax-meta">
                    <span class="tax-count">{(cat as any).article_count}</span>
                    <span class="tax-arrow">&rarr;</span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- 4. Editorial Briefing Callout -->
        <section class="briefing-box">
          <div class="briefing-content">
            <span class="briefing-tag">Editorial Mission</span>
            <h3 class="briefing-title">Engineering-Grade EV Journalism</h3>
            <p class="briefing-desc">
              ECargyan delivers structured technical intelligence for powertrain analysts, automotive engineers, battery researchers, and fleet planners.
            </p>
          </div>
          <div class="briefing-actions">
            <a href="/about" class="btn btn-primary">About Our Desk</a>
            <a href="/contact" class="btn btn-secondary">Contact Editors &nearr;</a>
          </div>
        </section>
      </>
    )}
  </div>
</BaseLayout>

<style>
  .lead-banner {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: clamp(2rem, 4.5vw, 3.25rem) 0 clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .lead-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
  }

  .lead-kicker {
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-electric-accent);
    display: block;
    margin-bottom: 0.5rem;
  }

  .lead-heading {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--color-brand);
    margin-bottom: 0.5rem;
  }

  .lead-deck {
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    color: var(--color-text-secondary);
    max-width: 620px;
    line-height: 1.5;
  }

  .lead-meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    background-color: var(--color-electric-green);
    border-radius: 50%;
  }

  .main-editorial-wrapper {
    padding: clamp(2rem, 4vw, 3.5rem) 1.5rem clamp(3rem, 6vw, 6rem);
  }

  /* 1. Hero Split Section */
  .hero-split-section {
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .hero-split-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2rem;
    align-items: stretch;
  }

  .hero-lead-col {
    display: flex;
    flex-direction: column;
  }

  .hero-secondary-col {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .secondary-header {
    padding-bottom: 0.75rem;
    margin-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-brand);
  }

  .secondary-title {
    font-size: 0.8125rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brand);
  }

  .secondary-list {
    display: flex;
    flex-direction: column;
  }

  /* 2. Latest Feed Grid */
  .latest-feed-section {
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .articles-grid-3col {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  /* 3. Taxonomy Section */
  .taxonomy-browse-section {
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .taxonomy-chips-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .taxonomy-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.15rem 1.25rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: all 0.18s ease;
  }

  .taxonomy-card:hover {
    border-color: var(--color-electric-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .tax-card-main {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .tax-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .tax-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .tax-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tax-count {
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    color: var(--color-text-secondary);
  }

  .tax-arrow {
    font-size: 0.875rem;
    color: var(--color-electric-accent);
  }

  /* 4. Briefing Callout Box */
  .briefing-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--color-brand);
    color: #ffffff;
    border-radius: var(--radius-sm);
    padding: clamp(2rem, 4vw, 3rem);
    gap: 2rem;
  }

  .briefing-tag {
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #38bdf8;
    display: block;
    margin-bottom: 0.5rem;
  }

  .briefing-title {
    font-size: clamp(1.35rem, 3vw, 1.85rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .briefing-desc {
    color: #94a3b8;
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 580px;
  }

  .briefing-actions {
    display: flex;
    gap: 0.75rem;
    white-space: nowrap;
  }

  .briefing-actions .btn-secondary {
    background-color: transparent;
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .briefing-actions .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: #ffffff;
  }

  .briefing-actions .btn-primary {
    background-color: #ffffff;
    color: var(--color-brand);
    border-color: #ffffff;
  }

  .briefing-actions .btn-primary:hover {
    background-color: #f1f5f9;
  }

  /* Responsive Rules */
  @media (max-width: 1024px) {
    .hero-split-grid {
      grid-template-columns: 1fr;
    }

    .hero-secondary-col {
      padding: 1.25rem;
    }
  }

  @media (max-width: 768px) {
    .lead-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .briefing-box {
      flex-direction: column;
      align-items: flex-start;
    }

    .articles-grid-3col {
      grid-template-columns: 1fr;
    }
  }
</style>
