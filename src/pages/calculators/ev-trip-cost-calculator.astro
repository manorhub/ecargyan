---
import CalculatorShell from '../../components/calculators/CalculatorShell.astro';
import { CALCULATOR_REGISTRY } from '../../lib/calculators/registry.ts';

const calculator = CALCULATOR_REGISTRY['ev-trip-cost-calculator'];
---

<CalculatorShell calculator={calculator}>
  <div class="calc-interface-grid">
    <!-- Left Column: Inputs -->
    <div class="calc-inputs-column">
      <div class="column-header">
        <h2 class="column-title">Trip Route Parameters</h2>
        <span class="column-subtitle">Compute highway energy and journey cost</span>
      </div>

      <form id="calc-form" class="calc-form" onsubmit="return false;">
        <!-- Currency Selection -->
        <div class="form-row">
          <label class="form-label" for="currency-select">Currency</label>
          <select id="currency-select" class="form-select">
            <option value="INR" selected>INR (₹) — Indian Rupee</option>
            <option value="USD">USD ($) — US Dollar</option>
            <option value="EUR">EUR (€) — Euro</option>
            <option value="GBP">GBP (£) — British Pound</option>
            <option value="AED">AED (د.إ) — UAE Dirham</option>
            <option value="AUD">AUD (A$) — Australian Dollar</option>
            <option value="CAD">CAD (C$) — Canadian Dollar</option>
          </select>
        </div>

        <!-- Trip Distance -->
        <div class="form-row">
          <div class="label-with-val">
            <label class="form-label" for="trip-dist">Total Trip Distance</label>
            <span class="inline-unit-hint">km</span>
          </div>
          <input type="number" id="trip-dist" class="form-input" value="350" min="1" max="10000" step="5" required />
          <span class="field-hint">e.g. 350 km intercity highway road trip</span>
        </div>

        <!-- Efficiency Input with Unit Selector -->
        <div class="form-row">
          <div class="label-with-val">
            <label class="form-label" for="efficiency-input">Highway Efficiency</label>
            <select id="efficiency-unit" class="unit-mini-select">
              <option value="km/kWh" selected>km/kWh</option>
              <option value="Wh/km">Wh/km</option>
              <option value="kWh/100km">kWh/100km</option>
              <option value="mi/kWh">mi/kWh</option>
            </select>
          </div>
          <input type="number" id="efficiency-input" class="form-input" value="6.2" min="0.1" max="1000" step="0.1" required />
          <span class="field-hint">Highway cruising consumes ~15–20% more energy than city driving</span>
        </div>

        <!-- Charging Tariff -->
        <div class="form-row">
          <div class="label-with-val">
            <label class="form-label" for="rate">Electricity Rate / Fast Charger Fee</label>
            <span id="rate-symbol" class="inline-unit-hint">₹ / kWh</span>
          </div>
          <input type="number" id="rate" class="form-input" value="18.00" min="0.1" max="150" step="0.5" required />
          <span class="field-hint">Public DC fast chargers typically charge ₹16 to ₹22 per kWh</span>
        </div>

        <!-- Charging Efficiency -->
        <div class="form-row">
          <div class="label-with-val">
            <label class="form-label" for="efficiency-loss">Replenishment Efficiency</label>
            <span id="eff-loss-val" class="live-slider-val">92%</span>
          </div>
          <input type="range" id="efficiency-loss" min="80" max="98" value="92" step="1" class="form-slider" />
        </div>

        <div class="form-actions-row">
          <button type="button" id="reset-btn" class="btn btn-secondary btn-sm">Reset Defaults</button>
        </div>
      </form>
    </div>

    <!-- Right Column: Results -->
    <div class="calc-results-column">
      <div class="results-card">
        <div class="primary-result-box">
          <span class="primary-result-lbl">Total Trip Energy Cost</span>
          <span id="res-total-trip-cost" class="primary-result-val">₹1,104.49</span>
          <span id="res-cost-per-km" class="primary-result-sub">₹3.16 per kilometer</span>
        </div>

        <div class="breakdown-table">
          <div class="breakdown-row">
            <span class="row-lbl">Battery Energy Consumed:</span>
            <span id="res-battery-req" class="row-val">56.45 kWh</span>
          </div>
          <div class="breakdown-row">
            <span class="row-lbl">Grid Energy Required:</span>
            <span id="res-grid-req" class="row-val">61.36 kWh</span>
          </div>
          <div class="breakdown-row">
            <span class="row-lbl">Trip Distance:</span>
            <span id="res-dist" class="row-val">350 km</span>
          </div>
        </div>

        <div class="results-note">
          <span class="note-icon">🛣</span>
          <p>For a 350 km trip in a petrol car (14 km/L at ₹102/L), fuel would cost ₹2,550.00 — EV saves ₹1,445.51 on this route.</p>
        </div>
      </div>
    </div>
  </div>
</CalculatorShell>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const currencySelect = document.getElementById('currency-select');
    const tripDist = document.getElementById('trip-dist');
    const efficiencyInput = document.getElementById('efficiency-input');
    const efficiencyUnit = document.getElementById('efficiency-unit');
    const rate = document.getElementById('rate');
    const efficiencyLoss = document.getElementById('efficiency-loss');
    const resetBtn = document.getElementById('reset-btn');

    const effLossVal = document.getElementById('eff-loss-val');
    const rateSymbol = document.getElementById('rate-symbol');
    const resTotalTripCost = document.getElementById('res-total-trip-cost');
    const resCostPerKm = document.getElementById('res-cost-per-km');
    const resBatteryReq = document.getElementById('res-battery-req');
    const resGridReq = document.getElementById('res-grid-req');
    const resDist = document.getElementById('res-dist');

    const currencySymbols = {
      INR: '₹',
      USD: '$',
      EUR: '€',
      GBP: '£',
      AED: 'د.إ',
      AUD: 'A$',
      CAD: 'C$',
    };

    function formatMoney(amount, curr) {
      const sym = currencySymbols[curr] || '₹';
      if (curr === 'AED') return `${amount.toFixed(2)} ${sym}`;
      return `${sym}${amount.toFixed(2)}`;
    }

    function toKmPerKwh(val, unit) {
      if (val <= 0) return 0;
      if (unit === 'km/kWh') return val;
      if (unit === 'Wh/km') return 1000 / val;
      if (unit === 'kWh/100km') return 100 / val;
      if (unit === 'mi/kWh') return val * 1.60934;
      return val;
    }

    function calculate() {
      const dist = parseFloat(tripDist.value) || 0;
      const effVal = parseFloat(efficiencyInput.value) || 0;
      const unit = efficiencyUnit.value || 'km/kWh';
      const r = parseFloat(rate.value) || 0;
      const effLoss = parseFloat(efficiencyLoss.value) || 92;
      const curr = currencySelect.value || 'INR';

      effLossVal.textContent = `${effLoss}%`;
      rateSymbol.textContent = `${currencySymbols[curr] || '₹'} / kWh`;

      const kmPerKwh = toKmPerKwh(effVal, unit);
      if (dist <= 0 || kmPerKwh <= 0 || r <= 0) {
        resTotalTripCost.textContent = formatMoney(0, curr);
        resCostPerKm.textContent = `${formatMoney(0, curr)} per km`;
        resBatteryReq.textContent = '0 kWh';
        resGridReq.textContent = '0 kWh';
        resDist.textContent = `${dist} km`;
        return;
      }

      const effFactor = effLoss / 100;
      const batteryReq = dist / kmPerKwh;
      const gridReq = effFactor > 0 ? batteryReq / effFactor : 0;
      const totalCost = gridReq * r;
      const perKm = dist > 0 ? totalCost / dist : 0;

      resTotalTripCost.textContent = formatMoney(totalCost, curr);
      resCostPerKm.textContent = `${formatMoney(perKm, curr)} per kilometer`;
      resBatteryReq.textContent = `${batteryReq.toFixed(2)} kWh`;
      resGridReq.textContent = `${gridReq.toFixed(2)} kWh`;
      resDist.textContent = `${dist} km`;
    }

    [currencySelect, tripDist, efficiencyInput, efficiencyUnit, rate, efficiencyLoss].forEach((el) => {
      el.addEventListener('input', calculate);
      el.addEventListener('change', calculate);
    });

    resetBtn.addEventListener('click', () => {
      currencySelect.value = 'INR';
      tripDist.value = '350';
      efficiencyUnit.value = 'km/kWh';
      efficiencyInput.value = '6.2';
      rate.value = '18.00';
      efficiencyLoss.value = '92';
      calculate();
    });

    calculate();
  });
</script>

<style>
  .calc-interface-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .column-header {
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .column-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-brand);
    margin-bottom: 0.25rem;
  }

  .column-subtitle {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .calc-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .label-with-val {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .unit-mini-select {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    background-color: var(--color-surface-subtle);
    color: var(--color-text-secondary);
  }

  .inline-unit-hint {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .live-slider-val {
    font-size: 0.8125rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--color-electric-accent);
  }

  .form-select {
    width: 100%;
    padding: 0.6rem 0.75rem;
    font-size: 0.9375rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    color: var(--color-text-main);
  }

  .form-slider {
    width: 100%;
    accent-color: var(--color-electric-accent);
    cursor: pointer;
  }

  .field-hint {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .form-actions-row {
    padding-top: 0.5rem;
  }

  /* Results Card */
  .results-card {
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .primary-result-box {
    background-color: var(--color-brand);
    color: #ffffff;
    padding: 1.5rem;
    border-radius: var(--radius-xs);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .primary-result-lbl {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #38bdf8;
  }

  .primary-result-val {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-family: var(--font-display);
  }

  .primary-result-sub {
    font-size: 0.8125rem;
    color: #94a3b8;
  }

  .breakdown-table {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background-color: var(--color-surface);
    padding: 1.25rem;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
  }

  .row-lbl {
    color: var(--color-text-secondary);
  }

  .row-val {
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--color-brand);
  }

  .results-note {
    display: flex;
    gap: 0.65rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  @media (max-width: 860px) {
    .calc-interface-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
