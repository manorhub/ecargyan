---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import JsonLd from '../../components/ui/JsonLd.astro';
import CalculatorCard from '../../components/calculators/CalculatorCard.astro';
import { CALCULATOR_REGISTRY, CALCULATOR_CATEGORIES } from '../../lib/calculators/registry.ts';
import { getCanonicalUrl } from '../../lib/config/site';

const canonicalUrl = getCanonicalUrl('/calculators');

const breadcrumbItems = [
  { name: 'Calculators', url: '/calculators' },
];

const allCalculators = Object.values(CALCULATOR_REGISTRY).filter((c) => c.published);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'EV Calculators & Energy Analytics — ECargyan',
  url: canonicalUrl,
  description: 'Comprehensive suite of deterministic electric vehicle calculators for charging costs, trip energy, battery health, running expenses, and total cost of ownership.',
  hasPart: allCalculators.map((c) => ({
    '@type': 'WebApplication',
    name: c.title,
    url: getCanonicalUrl(`/calculators/${c.slug}`),
    description: c.metaDescription,
  })),
};
---

<BaseLayout
  seo={{
    title: 'EV Calculators & Financial Tools | ECargyan',
    description: 'Explore 12 deterministic EV calculators: charging cost, charging time, running cost per km, petrol vs EV savings, battery degradation, and total cost of ownership.',
    canonicalUrl,
    ogType: 'website',
  }}
  currentPath="/calculators"
>
  <JsonLd schema={websiteSchema} />

  <!-- Index Masthead -->
  <header class="calc-index-masthead">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />

      <div class="calc-index-header-inner">
        <span class="calc-index-kicker">Automotive Engineering & Financial Tools</span>
        <h1 class="calc-index-title">Electric Vehicle Calculators</h1>
        <p class="calc-index-deck">
          Deterministic mathematical models for powertrain analysis, charging replenishment, lifecycle ownership economics, and fleet operational savings.
        </p>

        <div class="calc-stats-bar">
          <div class="stat-pill">
            <span class="stat-num">{allCalculators.length}</span>
            <span class="stat-lbl">Interactive Tools</span>
          </div>
          <div class="stat-pill">
            <span class="stat-num">100%</span>
            <span class="stat-lbl">Deterministic Math</span>
          </div>
          <div class="stat-pill">
            <span class="stat-num">7</span>
            <span class="stat-lbl">Global Currencies</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Calculator Directory -->
  <main class="container calc-directory-container">
    <!-- Category Filter Navigation -->
    <div class="category-filter-nav" id="filter-nav">
      <button class="filter-btn active" data-category="all">All Tools ({allCalculators.length})</button>
      {CALCULATOR_CATEGORIES.map((cat) => {
        const count = allCalculators.filter((c) => c.category === cat.id).length;
        return (
          <button class="filter-btn" data-category={cat.id}>
            {cat.name} ({count})
          </button>
        );
      })}
    </div>

    <!-- Calculators Grid -->
    <div class="calculators-grid" id="calculators-grid">
      {allCalculators.map((calc) => (
        <div class="calc-grid-item" data-category={calc.category}>
          <CalculatorCard calculator={calc} />
        </div>
      ))}
    </div>

    <!-- Technical Methodology Section -->
    <section class="methodology-section">
      <div class="section-header">
        <h2 class="section-title">Our Calculation Methodology</h2>
      </div>
      <div class="methodology-grid">
        <div class="methodology-card">
          <span class="methodology-icon">⚙</span>
          <h3 class="methodology-title">Pure Deterministic Formulas</h3>
          <p class="methodology-text">
            All numerical results are computed directly through physical thermodynamics and electrical engineering equations in code. No probabilistic guesses or arbitrary estimations.
          </p>
        </div>
        <div class="methodology-card">
          <span class="methodology-icon">⚡</span>
          <h3 class="methodology-title">Real-World Energy Losses</h3>
          <p class="methodology-text">
            Our charging tools factor in AC-to-DC rectification losses, battery thermal conditioning draw, and constant-current constant-voltage (CCCV) power tapering.
          </p>
        </div>
        <div class="methodology-card">
          <span class="methodology-icon">🔒</span>
          <h3 class="methodology-title">Zero Data Collection</h3>
          <p class="methodology-text">
            All calculations execute client-side inside your browser. Your mileage, vehicle budgets, and financial parameters are never transmitted or stored on external servers.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const gridItems = document.querySelectorAll('.calc-grid-item');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const selectedCat = btn.getAttribute('data-category');

        gridItems.forEach((item) => {
          const itemCat = item.getAttribute('data-category');
          if (selectedCat === 'all' || itemCat === selectedCat) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  .calc-index-masthead {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(2rem, 4vw, 3rem);
  }

  .calc-index-header-inner {
    margin-top: 0.75rem;
    max-width: 820px;
  }

  .calc-index-kicker {
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-electric-accent);
    display: block;
    margin-bottom: 0.5rem;
  }

  .calc-index-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--color-brand);
    margin-bottom: 0.75rem;
  }

  .calc-index-deck {
    font-size: clamp(1rem, 2.2vw, 1.15rem);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .calc-stats-bar {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .stat-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
  }

  .stat-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--color-brand);
  }

  .stat-lbl {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .calc-directory-container {
    padding: clamp(2.5rem, 5vw, 4rem) 1.5rem clamp(3rem, 6vw, 6rem);
  }

  .category-filter-nav {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    margin-bottom: 2.5rem;
    scrollbar-width: none;
  }

  .category-filter-nav::-webkit-scrollbar {
    display: none;
  }

  .filter-btn {
    padding: 0.5rem 1rem;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .filter-btn:hover {
    border-color: var(--color-border-dark);
    color: var(--color-brand);
  }

  .filter-btn.active {
    background-color: var(--color-brand);
    color: #ffffff;
    border-color: var(--color-brand);
  }

  .calculators-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
    margin-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }

  /* Methodology */
  .methodology-section {
    border-top: 1px solid var(--color-border);
    padding-top: 3rem;
  }

  .methodology-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.75rem;
  }

  .methodology-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .methodology-icon {
    font-size: 1.5rem;
    color: var(--color-electric-accent);
  }

  .methodology-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-brand);
  }

  .methodology-text {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .calculators-grid {
      grid-template-columns: 1fr;
    }

    .methodology-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
