---
import CalculatorShell from '../../components/calculators/CalculatorShell.astro';
import { CALCULATOR_REGISTRY } from '../../lib/calculators/registry.ts';

const calculator = CALCULATOR_REGISTRY['home-ev-charging-calculator'];
---

<CalculatorShell calculator={calculator}>
  <div class="calc-interface-grid">
    <!-- Left Column: Inputs -->
    <div class="calc-inputs-column">
      <div class="column-header">
        <h2 class="column-title">Residential Charging Setup</h2>
        <span class="column-subtitle">Configure home power connection & tariffs</span>
      </div>

      <form id="calc-form" class="calc-form" onsubmit="return false;">
        <!-- Currency Selection -->
        <div class="form-row">
          <label class="form-label" for="currency-select">Currency</label>
          <select id="currency-select" class="form-select">
            <option value="INR" selected>INR (₹) — Indian Rupee</option>
            <option value="USD">USD ($) — US Dollar</option>
            <option value="EUR">EUR (€) — Euro</option>
            <option value="GBP">GBP (£) — British Pound</option>
            <option value="AED">AED (د.إ) — UAE Dirham</option>
            <option value="AUD">AUD (A$) — Australian Dollar</option>
            <option value="CAD">CAD (C$) — Canadian Dollar</option>
          </select>
        </div>

        <!-- Battery Capacity -->
        <div class="form-row">
          <div class="label-with-val">
            <label class="form-label" for="battery-capacity">Vehicle Battery Capacity</label>
            <span class="inline-unit-hint">kWh</span>
          </div>
          <input type="number" id="battery-capacity" class="form-input" value="42" min="1" max="250" step="0.5" required />
        </div>

        <!-- SOC Range -->
        <div class="soc-slider-group">
          <div class="form-row">
            <div class="label-with-val">
              <label class="form-label" for="current-soc">Starting SOC</label>
              <span id="current-soc-val" class="live-slider-val">30%</span>
            </div>
            <input type="range" id="current-soc" min="0" max="95" value="30" step="5" class="form-slider" />
          </div>

          <div class="form-row">
            <div class="label-with-val">
              <label class="form-label" for="target-soc">Target SOC</label>
              <span id="target-soc-val" class="live-slider-val">90%</span>
            </div>
            <input type="range" id="target-soc" min="5" max="100" value="90" step="5" class="form-slider" />
          </div>
        </div>

        <!-- Charger Power -->
        <div class="form-row">
          <div class="label-with-val">
            <label class="form-label" for="charger-power">Home Charger Rating</label>
            <span class="inline-unit-hint">kW</span>
          </div>
          <input type="number" id="charger-power" class="form-input" value="3.3" min="1" max="22" step="0.1" required />
          <div class="preset-pills">
            <button type="button" class="preset-pill active" data-power="3.3">3.3 kW (16A Socket)</button>
            <button type="button" class="preset-pill" data-power="7.4">7.4 kW (Wallbox)</button>
            <button type="button" class="preset-pill" data-power="11">11 kW (3-Phase AC)</button>
          </div>
        </div>

        <!-- Domestic Tariff -->
        <div class="form-row">
          <div class="label-with-val">
            <label class="form-label" for="tariff">Domestic Electricity Tariff</label>
            <span id="tariff-symbol" class="inline-unit-hint">₹ / kWh</span>
          </div>
          <input type="number" id="tariff" class="form-input" value="6.50" min="0.1" max="100" step="0.25" required />
        </div>

        <!-- Efficiency -->
        <div class="form-row">
          <div class="label-with-val">
            <label class="form-label" for="efficiency">Conversion Efficiency</label>
            <span id="efficiency-val" class="live-slider-val">88%</span>
          </div>
          <input type="range" id="efficiency" min="75" max="98" value="88" step="1" class="form-slider" />
        </div>

        <div class="form-actions-row">
          <button type="button" id="reset-btn" class="btn btn-secondary btn-sm">Reset Defaults</button>
        </div>
      </form>
    </div>

    <!-- Right Column: Results -->
    <div class="calc-results-column">
      <div class="results-card">
        <div class="primary-result-box">
          <span class="primary-result-lbl">Home Session Charging Cost</span>
          <span id="res-total-cost" class="primary-result-val">₹185.94</span>
          <span id="res-time-est" class="primary-result-sub">Approx. 8h 40m overnight duration</span>
        </div>

        <div class="breakdown-table">
          <div class="breakdown-row">
            <span class="row-lbl">Battery Energy Added:</span>
            <span id="res-bat-added" class="row-val">25.20 kWh</span>
          </div>
          <div class="breakdown-row">
            <span class="row-lbl">Grid Energy Billed:</span>
            <span id="res-grid-billed" class="row-val">28.64 kWh</span>
          </div>
          <div class="breakdown-row">
            <span class="row-lbl">Charger Power:</span>
            <span id="res-power-lbl" class="row-val">3.3 kW (16A)</span>
          </div>
        </div>

        <div class="results-note">
          <span class="note-icon">🌙</span>
          <p>Overnight charging at 3.3 kW easily replenishes 25 kWh (approx. 175 km range) while sleeping.</p>
        </div>
      </div>
    </div>
  </div>
</CalculatorShell>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const currencySelect = document.getElementById('currency-select');
    const batteryCapacity = document.getElementById('battery-capacity');
    const currentSoc = document.getElementById('current-soc');
    const targetSoc = document.getElementById('target-soc');
    const chargerPower = document.getElementById('charger-power');
    const tariff = document.getElementById('tariff');
    const efficiency = document.getElementById('efficiency');
    const resetBtn = document.getElementById('reset-btn');
    const presetPills = document.querySelectorAll('.preset-pill');

    const currentSocVal = document.getElementById('current-soc-val');
    const targetSocVal = document.getElementById('target-soc-val');
    const efficiencyVal = document.getElementById('efficiency-val');
    const tariffSymbol = document.getElementById('tariff-symbol');

    const resTotalCost = document.getElementById('res-total-cost');
    const resTimeEst = document.getElementById('res-time-est');
    const resBatAdded = document.getElementById('res-bat-added');
    const resGridBilled = document.getElementById('res-grid-billed');
    const resPowerLbl = document.getElementById('res-power-lbl');

    const currencySymbols = {
      INR: '₹',
      USD: '$',
      EUR: '€',
      GBP: '£',
      AED: 'د.إ',
      AUD: 'A$',
      CAD: 'C$',
    };

    function formatMoney(amount, curr) {
      const sym = currencySymbols[curr] || '₹';
      if (curr === 'AED') return `${amount.toFixed(2)} ${sym}`;
      return `${sym}${amount.toFixed(2)}`;
    }

    function formatTime(hoursDecimal) {
      if (hoursDecimal <= 0 || !isFinite(hoursDecimal)) return '0m';
      const totalMinutes = Math.round(hoursDecimal * 60);
      const hours = Math.floor(totalMinutes / 60);
      const minutes = totalMinutes % 60;
      if (hours === 0) return `${minutes}m`;
      if (minutes === 0) return `${hours}h`;
      return `${hours}h ${minutes}m`;
    }

    function calculate() {
      let cap = parseFloat(batteryCapacity.value) || 0;
      let cSoc = parseFloat(currentSoc.value) || 0;
      let tSoc = parseFloat(targetSoc.value) || 0;
      let power = parseFloat(chargerPower.value) || 1;
      let tRate = parseFloat(tariff.value) || 0;
      let eff = parseFloat(efficiency.value) || 88;
      const curr = currencySelect.value || 'INR';

      if (tSoc < cSoc) {
        tSoc = cSoc;
        targetSoc.value = cSoc;
      }

      currentSocVal.textContent = `${cSoc}%`;
      targetSocVal.textContent = `${tSoc}%`;
      efficiencyVal.textContent = `${eff}%`;
      tariffSymbol.textContent = `${currencySymbols[curr] || '₹'} / kWh`;

      const socDelta = tSoc - cSoc;
      const batteryAdded = (cap * socDelta) / 100;
      const effFactor = eff / 100;
      const gridBilled = effFactor > 0 ? batteryAdded / effFactor : 0;
      const totalCost = gridBilled * tRate;

      const effPower = power * effFactor;
      const durationHours = effPower > 0 ? batteryAdded / effPower : 0;

      resTotalCost.textContent = formatMoney(totalCost, curr);
      resTimeEst.textContent = `Approx. ${formatTime(durationHours)} overnight duration`;
      resBatAdded.textContent = `${batteryAdded.toFixed(2)} kWh`;
      resGridBilled.textContent = `${gridBilled.toFixed(2)} kWh`;
      resPowerLbl.textContent = `${power.toFixed(1)} kW AC`;
    }

    presetPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        presetPills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        chargerPower.value = pill.getAttribute('data-power');
        calculate();
      });
    });

    [currencySelect, batteryCapacity, currentSoc, targetSoc, chargerPower, tariff, efficiency].forEach((el) => {
      el.addEventListener('input', calculate);
      el.addEventListener('change', calculate);
    });

    resetBtn.addEventListener('click', () => {
      currencySelect.value = 'INR';
      batteryCapacity.value = '42';
      currentSoc.value = '30';
      targetSoc.value = '90';
      chargerPower.value = '3.3';
      tariff.value = '6.50';
      efficiency.value = '88';
      presetPills.forEach((p) => p.classList.remove('active'));
      presetPills[0].classList.add('active');
      calculate();
    });

    calculate();
  });
</script>

<style>
  .calc-interface-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .column-header {
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .column-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-brand);
    margin-bottom: 0.25rem;
  }

  .column-subtitle {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .calc-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .label-with-val {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .inline-unit-hint {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .live-slider-val {
    font-size: 0.8125rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--color-electric-accent);
  }

  .form-select {
    width: 100%;
    padding: 0.6rem 0.75rem;
    font-size: 0.9375rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    color: var(--color-text-main);
  }

  .form-slider {
    width: 100%;
    accent-color: var(--color-electric-accent);
    cursor: pointer;
  }

  .preset-pills {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.35rem;
  }

  .preset-pill {
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    background-color: var(--color-surface-subtle);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .preset-pill:hover {
    border-color: var(--color-border-dark);
    color: var(--color-brand);
  }

  .preset-pill.active {
    background-color: var(--color-brand);
    color: #ffffff;
    border-color: var(--color-brand);
  }

  .form-actions-row {
    padding-top: 0.5rem;
  }

  /* Results Card */
  .results-card {
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .primary-result-box {
    background-color: var(--color-brand);
    color: #ffffff;
    padding: 1.5rem;
    border-radius: var(--radius-xs);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .primary-result-lbl {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #38bdf8;
  }

  .primary-result-val {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-family: var(--font-display);
  }

  .primary-result-sub {
    font-size: 0.8125rem;
    color: #94a3b8;
  }

  .breakdown-table {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background-color: var(--color-surface);
    padding: 1.25rem;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border);
  }

  .breakdown-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
  }

  .row-lbl {
    color: var(--color-text-secondary);
  }

  .row-val {
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--color-brand);
  }

  .results-note {
    display: flex;
    gap: 0.65rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  @media (max-width: 860px) {
    .calc-interface-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
