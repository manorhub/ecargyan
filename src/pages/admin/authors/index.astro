---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db/client';

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);
const authors = dbService ? await dbService.listAuthors() : [];
---

<AdminLayout title="Authors" currentPath="/admin/authors">
  <div class="page-header">
    <div>
      <h1 class="page-title">Editorial Authors</h1>
      <p class="page-description">
        Manage journalists, analysts, and contributor profiles.
      </p>
    </div>
    <div>
      <a href="/admin/authors/new" class="btn btn-primary">Add Author</a>
    </div>
  </div>

  <div class="table-card">
    <div class="card-header">
      <h2 class="card-title">Authors Registry ({authors.length})</h2>
    </div>

    {authors.length === 0 ? (
      <div class="empty-box">
        <p class="empty-text">No authors yet.</p>
        <span class="empty-subtext">Add author profiles to attribute editorial reports and articles.</span>
        <div class="empty-action">
          <a href="/admin/authors/new" class="btn btn-secondary">Create First Author</a>
        </div>
      </div>
    ) : (
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Author Name</th>
              <th>Slug</th>
              <th>Bio</th>
              <th>Articles</th>
              <th>Status</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            {authors.map((author) => (
              <tr>
                <td><strong>{author.name}</strong></td>
                <td><code class="slug-code">@{author.slug}</code></td>
                <td><span class="bio-snippet">{author.bio || 'No bio provided.'}</span></td>
                <td><span class="badge badge-neutral">{author.article_count ?? 0}</span></td>
                <td>
                  <span class:list={['badge', author.status === 'active' ? 'badge-success' : 'badge-neutral']}>
                    {author.status}
                  </span>
                </td>
                <td class="text-right">
                  <div class="actions-group">
                    <a href={`/admin/authors/${author.id}/edit`} class="btn btn-secondary btn-xs">
                      Edit
                    </a>
                    <form action="/admin/authors/delete" method="POST" onsubmit="return confirm('Delete author profile? Articles by this author will be retained.');">
                      <input type="hidden" name="id" value={author.id} />
                      <button type="submit" class="btn btn-danger btn-xs">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .page-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .table-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .card-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .empty-box {
    padding: 4rem 2rem;
    text-align: center;
  }

  .empty-text {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .empty-subtext {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .empty-action {
    margin-top: 1.5rem;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .admin-table th {
    text-align: left;
    padding: 0.75rem 1.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    background-color: var(--color-surface-subtle);
    border-bottom: 1px solid var(--color-border);
  }

  .admin-table td {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  .bio-snippet {
    display: block;
    max-width: 300px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .slug-code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background-color: var(--color-surface-subtle);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    color: var(--color-brand-accent);
  }

  .text-right {
    text-align: right;
  }

  .actions-group {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }

  .btn-xs {
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
  }
</style>
