---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db/client';

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);

let metrics = {
  publishing: { published: 0, review: 0, scheduled: 0, drafts: 0 },
  sources: { active: 0, paused: 0, failing: 0, total: 0 },
  research: { ready: 0, processing: 0, ignored: 0, merged: 0, total: 0 },
  ai: { totalRuns: 0, completed: 0, failed: 0, totalTokens: 0 },
  automation: { running: true, pending: 0, failed: 0, deadLetter: 0 },
  seo: { missingMeta: 0, orphanArticles: 0, brokenLinks: 0, redirects: 0 },
};

let recentLogs: any[] = [];

if (dbService) {
  [metrics, { logs: recentLogs }] = await Promise.all([
    dbService.getOperationalMetrics(),
    dbService.listAutomationLogs({ limit: 8 }),
  ]);
}

function formatDate(ts: number): string {
  return new Date(ts).toLocaleString('en-US', {
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}
---

<AdminLayout title="Operational Dashboard" currentPath="/admin">
  <div class="page-header">
    <div>
      <h1 class="page-title">Operations Control Dashboard</h1>
      <p class="page-description">Real-time telemetry across publishing, research, AI synthesis, automation queues, and SEO health.</p>
    </div>
    <div class="header-actions">
      <a href="/admin/review" class="btn btn-primary">
        Review Queue ({metrics.publishing.review})
      </a>
      <a href="/admin/automation" class="btn btn-secondary">
        Automation Center
      </a>
      <a href="/admin/system/health" class="btn btn-secondary">
        System Health
      </a>
    </div>
  </div>

  <!-- Operational Metric Pillars Grid -->
  <div class="metrics-pillars-grid">
    <!-- 1. Content & Publishing Pillar -->
    <div class="pillar-card">
      <div class="pillar-header">
        <h2 class="pillar-title">Publishing State</h2>
        <a href="/admin/articles" class="pillar-link">View &rarr;</a>
      </div>
      <div class="pillar-stats">
        <div class="stat-item">
          <span class="stat-num text-success">{metrics.publishing.published}</span>
          <span class="stat-lbl">Published</span>
        </div>
        <div class="stat-item">
          <span class="stat-num text-warning">{metrics.publishing.review}</span>
          <span class="stat-lbl">Review Queue</span>
        </div>
        <div class="stat-item">
          <span class="stat-num text-neutral">{metrics.publishing.drafts}</span>
          <span class="stat-lbl">Drafts</span>
        </div>
      </div>
    </div>

    <!-- 2. Research Pool Pillar -->
    <div class="pillar-card">
      <div class="pillar-header">
        <h2 class="pillar-title">Research Intelligence</h2>
        <a href="/admin/research" class="pillar-link">View &rarr;</a>
      </div>
      <div class="pillar-stats">
        <div class="stat-item">
          <span class="stat-num text-success">{metrics.research.ready}</span>
          <span class="stat-lbl">Ready for AI</span>
        </div>
        <div class="stat-item">
          <span class="stat-num text-neutral">{metrics.research.merged}</span>
          <span class="stat-lbl">Synthesized</span>
        </div>
        <div class="stat-item">
          <span class="stat-num text-muted">{metrics.research.total}</span>
          <span class="stat-lbl">Total Records</span>
        </div>
      </div>
    </div>

    <!-- 3. Sources Registry Pillar -->
    <div class="pillar-card">
      <div class="pillar-header">
        <h2 class="pillar-title">Sources Registry</h2>
        <a href="/admin/sources" class="pillar-link">View &rarr;</a>
      </div>
      <div class="pillar-stats">
        <div class="stat-item">
          <span class="stat-num text-success">{metrics.sources.active}</span>
          <span class="stat-lbl">Active Feeds</span>
        </div>
        <div class="stat-item">
          <span class="stat-num text-danger">{metrics.sources.failing}</span>
          <span class="stat-lbl">Failing Feeds</span>
        </div>
        <div class="stat-item">
          <span class="stat-num text-muted">{metrics.sources.total}</span>
          <span class="stat-lbl">Total Sources</span>
        </div>
      </div>
    </div>

    <!-- 4. AI Editorial Pillar -->
    <div class="pillar-card">
      <div class="pillar-header">
        <h2 class="pillar-title">AI Editorial Runs</h2>
        <a href="/admin/ai" class="pillar-link">View &rarr;</a>
      </div>
      <div class="pillar-stats">
        <div class="stat-item">
          <span class="stat-num text-success">{metrics.ai.completed}</span>
          <span class="stat-lbl">Completed Runs</span>
        </div>
        <div class="stat-item">
          <span class="stat-num text-danger">{metrics.ai.failed}</span>
          <span class="stat-lbl">Failed Runs</span>
        </div>
        <div class="stat-item">
          <span class="stat-num mono">{metrics.ai.totalTokens.toLocaleString()}</span>
          <span class="stat-lbl">Tokens Consumed</span>
        </div>
      </div>
    </div>

    <!-- 5. Automation Pipeline Pillar -->
    <div class="pillar-card">
      <div class="pillar-header">
        <h2 class="pillar-title">Automation Engine</h2>
        <a href="/admin/automation" class="pillar-link">View &rarr;</a>
      </div>
      <div class="pillar-stats">
        <div class="stat-item">
          <span class="stat-num" class:list={[{ 'text-success': metrics.automation.running, 'text-danger': !metrics.automation.running }]}>
            {metrics.automation.running ? 'RUNNING' : 'PAUSED'}
          </span>
          <span class="stat-lbl">Master Status</span>
        </div>
        <div class="stat-item">
          <span class="stat-num text-warning">{metrics.automation.pending}</span>
          <span class="stat-lbl">Queued Jobs</span>
        </div>
        <div class="stat-item">
          <span class="stat-num text-danger">{metrics.automation.deadLetter}</span>
          <span class="stat-lbl">Dead Letter</span>
        </div>
      </div>
    </div>

    <!-- 6. Technical SEO Health Pillar -->
    <div class="pillar-card">
      <div class="pillar-header">
        <h2 class="pillar-title">Technical SEO</h2>
        <a href="/admin/seo" class="pillar-link">View &rarr;</a>
      </div>
      <div class="pillar-stats">
        <div class="stat-item">
          <span class="stat-num text-warning">{metrics.seo.missingMeta}</span>
          <span class="stat-lbl">Missing Meta</span>
        </div>
        <div class="stat-item">
          <span class="stat-num text-danger">{metrics.seo.brokenLinks}</span>
          <span class="stat-lbl">Broken Links</span>
        </div>
        <div class="stat-item">
          <span class="stat-num text-neutral">{metrics.seo.redirects}</span>
          <span class="stat-lbl">301 Redirects</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Disconnected Analytics Placeholders (Zero Fake Data Guarantee) -->
  <div class="analytics-connectors-grid">
    <div class="connector-card">
      <div class="connector-header">
        <span class="connector-title">Google Search Console Integration</span>
        <span class="badge badge-neutral">Not Connected</span>
      </div>
      <p class="connector-desc">
        Search performance data (impressions, clicks, average keyword positions) is unavailable until Google Search Console API credentials are configured in site settings.
      </p>
    </div>

    <div class="connector-card">
      <div class="connector-header">
        <span class="connector-title">Web Traffic Analytics</span>
        <span class="badge badge-neutral">Not Connected</span>
      </div>
      <p class="connector-desc">
        Visitor traffic, pageviews, and session telemetry are unavailable until Cloudflare Web Analytics beacon token is configured. Zero fake metrics are displayed.
      </p>
    </div>
  </div>

  <!-- Recent Operational Activity Trail -->
  <div class="card">
    <div class="card-header-row">
      <h2 class="card-title">Recent Automation & System Logs</h2>
      <a href="/admin/system/logs" class="btn btn-secondary btn-xs">View All Logs &rarr;</a>
    </div>

    {recentLogs.length === 0 ? (
      <div class="empty-box">
        <p class="empty-text">No operational activity recorded yet.</p>
        <span class="empty-subtext">Events will appear here as the automation scheduler and ingestion workers execute.</span>
      </div>
    ) : (
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>Event</th>
              <th>Target</th>
              <th>Details</th>
            </tr>
          </thead>
          <tbody>
            {recentLogs.map((log) => (
              <tr>
                <td><span class="date-text">{formatDate(log.created_at)}</span></td>
                <td><span class="badge badge-neutral">{log.event_type}</span></td>
                <td><span class="entity-text">{log.entity_type ? `${log.entity_type}:${log.entity_id?.slice(0, 8)}` : '—'}</span></td>
                <td><span class="log-msg">{log.message}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .page-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .header-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .metrics-pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .pillar-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pillar-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .pillar-title {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-main);
  }

  .pillar-link {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .pillar-link:hover {
    color: var(--color-accent-blue);
  }

  .pillar-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .stat-num {
    font-size: 1.25rem;
    font-weight: 700;
    font-family: var(--font-mono);
  }

  .stat-lbl {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  .text-success { color: var(--color-success); }
  .text-warning { color: var(--color-warning); }
  .text-danger { color: var(--color-danger); }
  .text-neutral { color: var(--color-text-main); }
  .text-muted { color: var(--color-text-dim); }
  .mono { font-family: var(--font-mono); font-size: 1rem; }

  .analytics-connectors-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .connector-card {
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
  }

  .connector-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .connector-title {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .connector-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin: 0;
  }

  .card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .card-title {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }

  .admin-table th {
    text-align: left;
    padding: 0.6rem 1rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background-color: var(--color-surface-subtle);
    border-bottom: 1px solid var(--color-border);
  }

  .admin-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  .date-text, .entity-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .log-msg {
    color: var(--color-text-main);
  }

  .empty-box {
    padding: 3rem 1.5rem;
    text-align: center;
  }

  .empty-text {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .empty-subtext {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .btn-xs {
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
  }

  @media (max-width: 1100px) {
    .metrics-pillars-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .analytics-connectors-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .metrics-pillars-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
