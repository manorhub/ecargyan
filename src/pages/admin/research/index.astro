---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db/client';
import { calculateFreshness } from '../../../lib/processing/classifier';

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);

const url = new URL(Astro.request.url);
const statusFilter = url.searchParams.get('status') || '';
const typeFilter = url.searchParams.get('type') || '';
const topicFilter = url.searchParams.get('topic') || '';
const search = url.searchParams.get('q') || '';
const page = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));
const pageSize = 20;
const offset = (page - 1) * pageSize;

const successMsg = url.searchParams.get('success') || '';
const errorMsg = url.searchParams.get('error') || '';

let researchData = { items: [] as any[], total: 0 };
let topics: any[] = [];

if (dbService) {
  [researchData, topics] = await Promise.all([
    dbService.listResearchItems({
      status: statusFilter || undefined,
      contentType: typeFilter || undefined,
      topicId: topicFilter || undefined,
      search: search || undefined,
      limit: pageSize,
      offset,
    }),
    dbService.listTopics(),
  ]);
}

const totalPages = Math.ceil(researchData.total / pageSize) || 1;

function formatDate(ts: number | null): string {
  if (!ts) return '—';
  return new Date(ts).toLocaleString('en-US', {
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}

function getImportanceClass(score: number): string {
  if (score >= 75) return 'badge-danger';
  if (score >= 50) return 'badge-warning';
  return 'badge-neutral';
}

function getFreshnessClass(freshness: string): string {
  if (freshness === 'fresh') return 'badge-success';
  if (freshness === 'recent') return 'badge-neutral';
  if (freshness === 'aging') return 'badge-warning';
  return 'badge-neutral';
}
---

<AdminLayout title="Research Pool" currentPath="/admin/research">
  <div class="page-header">
    <div>
      <h1 class="page-title">Editorial Research Pool</h1>
      <p class="page-description">
        Normalized, deduplicated, and clustered research records ready for AI editorial synthesis.
      </p>
    </div>
    <div>
      <form action="/admin/research/process" method="POST" style="display:inline;">
        <input type="hidden" name="return_to" value="/admin/research" />
        <button type="submit" class="btn btn-primary">
          Process Pending Source Items
        </button>
      </form>
    </div>
  </div>

  {successMsg && <div class="alert alert-success">{successMsg}</div>}
  {errorMsg && <div class="alert alert-danger">{errorMsg}</div>}

  <div class="filter-panel">
    <form method="GET" class="filter-form">
      <div class="filter-group">
        <input
          type="search"
          name="q"
          value={search}
          placeholder="Search research topics..."
          class="form-input filter-search"
        />
      </div>

      <div class="filter-group">
        <select name="status" class="form-input filter-select" onchange="this.form.submit()">
          <option value="">All Statuses</option>
          <option value="ready" selected={statusFilter === 'ready'}>Ready for Synthesis</option>
          <option value="new" selected={statusFilter === 'new'}>New</option>
          <option value="merged" selected={statusFilter === 'merged'}>Merged</option>
          <option value="ignored" selected={statusFilter === 'ignored'}>Ignored</option>
          <option value="error" selected={statusFilter === 'error'}>Error</option>
        </select>
      </div>

      <div class="filter-group">
        <select name="type" class="form-input filter-select" onchange="this.form.submit()">
          <option value="">All Content Types</option>
          <option value="news" selected={typeFilter === 'news'}>News</option>
          <option value="announcement" selected={typeFilter === 'announcement'}>Announcement</option>
          <option value="analysis" selected={typeFilter === 'analysis'}>Analysis</option>
          <option value="guide" selected={typeFilter === 'guide'}>Guide</option>
          <option value="review" selected={typeFilter === 'review'}>Review</option>
          <option value="comparison" selected={typeFilter === 'comparison'}>Comparison</option>
          <option value="interview" selected={typeFilter === 'interview'}>Interview</option>
        </select>
      </div>

      <div class="filter-group">
        <select name="topic" class="form-input filter-select" onchange="this.form.submit()">
          <option value="">All Topics</option>
          {topics.map((t: any) => (
            <option value={t.id} selected={topicFilter === t.id}>{t.name}</option>
          ))}
        </select>
      </div>

      <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
      {(statusFilter || typeFilter || topicFilter || search) && (
        <a href="/admin/research" class="btn btn-secondary btn-sm">Reset</a>
      )}
    </form>
  </div>

  <div class="table-card">
    <div class="card-header">
      <h2 class="card-title">Research Items ({researchData.total})</h2>
    </div>

    {researchData.items.length === 0 ? (
      <div class="empty-box">
        <p class="empty-text">No research records yet.</p>
        <span class="empty-subtext">Ingest source feeds in the Source Registry, then trigger "Process Pending Source Items" to populate this pool.</span>
        <div class="empty-action">
          <a href="/admin/sources" class="btn btn-secondary">Open Source Registry</a>
        </div>
      </div>
    ) : (
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Research Headline</th>
              <th>Type</th>
              <th>Topic</th>
              <th>Sources</th>
              <th>Score</th>
              <th>Freshness</th>
              <th>Updated</th>
              <th class="text-right">Action</th>
            </tr>
          </thead>
          <tbody>
            {researchData.items.map((item) => {
              const freshness = calculateFreshness(item.first_seen_at);
              return (
                <tr>
                  <td>
                    <a href={`/admin/research/${item.id}`} class="research-title-link">
                      {item.title}
                    </a>
                    {item.summary && (
                      <span class="research-summary-hint">{item.summary}</span>
                    )}
                  </td>
                  <td>
                    <span class="type-pill">{item.content_type.toUpperCase()}</span>
                  </td>
                  <td>
                    {item.topic_name ? (
                      <span class="topic-badge">{item.topic_name}</span>
                    ) : (
                      <span class="text-muted">—</span>
                    )}
                  </td>
                  <td>
                    <span class:list={['sources-pill', { 'multi-source': item.source_count > 1 }]}>
                      {item.source_count} {item.source_count === 1 ? 'source' : 'sources'}
                    </span>
                  </td>
                  <td>
                    <span class:list={['badge', getImportanceClass(item.importance)]}>
                      {item.importance} / 100
                    </span>
                  </td>
                  <td>
                    <span class:list={['badge', getFreshnessClass(freshness)]}>
                      {freshness.toUpperCase()}
                    </span>
                  </td>
                  <td>
                    <span class="date-text">{formatDate(item.last_updated_at)}</span>
                  </td>
                  <td class="text-right">
                    <div class="actions-group">
                      <a href={`/admin/research/${item.id}`} class="btn btn-secondary btn-xs">
                        Inspect
                      </a>
                      {item.status !== 'ignored' ? (
                        <form action="/admin/research/ignore" method="POST" style="display:inline;">
                          <input type="hidden" name="id" value={item.id} />
                          <input type="hidden" name="status" value="ignored" />
                          <input type="hidden" name="return_to" value="/admin/research" />
                          <button type="submit" class="btn btn-secondary btn-xs" title="Mark Ignored">
                            Ignore
                          </button>
                        </form>
                      ) : (
                        <form action="/admin/research/ignore" method="POST" style="display:inline;">
                          <input type="hidden" name="id" value={item.id} />
                          <input type="hidden" name="status" value="ready" />
                          <input type="hidden" name="return_to" value="/admin/research" />
                          <button type="submit" class="btn btn-secondary btn-xs" title="Restore to Ready">
                            Restore
                          </button>
                        </form>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}

    {totalPages > 1 && (
      <div class="pagination">
        {page > 1 && (
          <a href={`?page=${page - 1}&status=${statusFilter}&type=${typeFilter}&topic=${topicFilter}&q=${search}`} class="btn btn-secondary btn-sm">
            &larr; Previous
          </a>
        )}
        <span class="page-info">Page {page} of {totalPages}</span>
        {page < totalPages && (
          <a href={`?page=${page + 1}&status=${statusFilter}&type=${typeFilter}&topic=${topicFilter}&q=${search}`} class="btn btn-secondary btn-sm">
            Next &rarr;
          </a>
        )}
      </div>
    )}
  </div>
</AdminLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .page-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .filter-panel {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
  }

  .filter-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .filter-search {
    min-width: 240px;
  }

  .filter-select {
    width: auto;
    min-width: 140px;
    font-size: 0.8125rem;
    padding: 0.5rem 0.75rem;
  }

  .table-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .card-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .admin-table th {
    text-align: left;
    padding: 0.75rem 1.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    background-color: var(--color-surface-subtle);
    border-bottom: 1px solid var(--color-border);
  }

  .admin-table td {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  .research-title-link {
    font-weight: 600;
    color: var(--color-text-main);
    display: block;
    line-height: 1.3;
  }

  .research-title-link:hover {
    color: var(--color-accent-blue);
  }

  .research-summary-hint {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    display: block;
    margin-top: 0.2rem;
    max-width: 380px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .type-pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.15rem 0.4rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .topic-badge {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-brand-accent);
  }

  .sources-pill {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    padding: 0.15rem 0.45rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }

  .sources-pill.multi-source {
    background-color: #dbeafe;
    color: #1e40af;
    border-color: #bfdbfe;
    font-weight: 600;
  }

  .date-text {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .text-muted {
    color: var(--color-text-dim);
  }

  .text-right {
    text-align: right;
  }

  .actions-group {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }

  .btn-sm {
    padding: 0.35rem 0.75rem;
    font-size: 0.8125rem;
  }

  .btn-xs {
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
  }

  .empty-box {
    padding: 4rem 2rem;
    text-align: center;
  }

  .empty-text {
    font-size: 1rem;
    font-weight: 600;
  }

  .empty-subtext {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .empty-action {
    margin-top: 1.5rem;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .page-info {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .alert {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }

  .alert-success {
    background-color: var(--color-success-bg);
    color: var(--color-success);
    border: 1px solid #bbf7d0;
  }

  .alert-danger {
    background-color: var(--color-danger-bg);
    color: var(--color-danger);
    border: 1px solid #fecaca;
  }
</style>
