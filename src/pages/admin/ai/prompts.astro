---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db/client';
import { CANONICAL_PROMPTS, type PromptDefinition } from '../../../lib/ai/prompts/registry';

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);
if (!dbService) return Astro.redirect('/admin', 302);

const url = new URL(Astro.request.url);
const successMsg = url.searchParams.get('success') || '';
const errorMsg = url.searchParams.get('error') || '';

let dbPrompts: any[] = [];
if (runtimeEnv?.DB) {
  try {
    const { results } = await runtimeEnv.DB
      .prepare('SELECT * FROM prompts ORDER BY task_type ASC, version DESC')
      .all<any>();
    dbPrompts = results || [];
  } catch (e) {
    // If table read fails, fall back to canonical prompts
  }
}

// Build map of DB prompts by ID or task_type
const dbPromptMap = new Map<string, any>();
for (const p of dbPrompts) {
  dbPromptMap.set(p.id, p);
  dbPromptMap.set(p.task_type, p);
}

// Merge canonical prompts with any customized database content
const displayPrompts: PromptDefinition[] = CANONICAL_PROMPTS.map((canonical) => {
  const dbRecord = dbPromptMap.get(canonical.id) || dbPromptMap.get(canonical.task_type);
  if (dbRecord) {
    return {
      ...canonical,
      name: dbRecord.name || canonical.name,
      version: dbRecord.version || canonical.version,
      content: dbRecord.content || canonical.content,
      status: (dbRecord.status as any) || canonical.status,
      updatedAt: dbRecord.updated_at || canonical.updatedAt,
    };
  }
  return canonical;
});
---

<AdminLayout title="AI Prompt Versions Management" currentPath="/admin/ai">
  <div class="page-header">
    <div class="header-left">
      <a href="/admin/ai" class="back-link">&larr; Back to AI Telemetry</a>
      <h1 class="page-title">AI Prompt Versions Management</h1>
      <p class="page-description">
        Inspect, verify, and manage system and formatting prompt templates across all DeepSeek-V3 editorial pipelines and FLUX.1 [schnell] visual generation stages.
      </p>
    </div>
    <div class="header-actions">
      <form action="/admin/ai/prompts/seed" method="POST">
        <button type="submit" class="btn btn-secondary">
          &#8635; Sync / Seed Prompts to D1
        </button>
      </form>
    </div>
  </div>

  {successMsg && <div class="alert alert-success">{successMsg}</div>}
  {errorMsg && <div class="alert alert-danger">{errorMsg}</div>}

  <!-- Metric Overview Cards -->
  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-label">Total Pipeline Prompts</span>
      <span class="stat-value">{displayPrompts.length}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Active Stages</span>
      <span class="stat-value text-success">{displayPrompts.filter((p) => p.status === 'active').length} Active</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Primary AI Models</span>
      <span class="stat-value text-accent">DeepSeek &bull; FLUX.1</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Schema Validation</span>
      <span class="stat-value text-success">100% Strict JSON</span>
    </div>
  </div>

  <!-- Prompts List -->
  <div class="prompts-container">
    {displayPrompts.map((p) => (
      <div class="prompt-card" id={`prompt-${p.id}`}>
        <div class="card-header">
          <div class="header-main-info">
            <div class="stage-tag-wrap">
              <span class="badge badge-stage">{p.stageName}</span>
              <span class="model-badge">Target: {p.targetModel}</span>
            </div>
            <h2 class="prompt-name">{p.name}</h2>
            <p class="prompt-desc">{p.description}</p>
          </div>
          <div class="header-badges">
            <span class="version-pill">{p.versionTag}</span>
            <span class:list={['badge', p.status === 'active' ? 'badge-success' : 'badge-neutral']}>
              {p.status.toUpperCase()}
            </span>
          </div>
        </div>

        <div class="card-body">
          <div class="section-block">
            <div class="section-label-bar">
              <span class="section-label">&#9881; System Prompt &amp; Behavioral Directives</span>
              <button
                type="button"
                class="btn-copy-prompt"
                data-target={`code-${p.id}`}
                title="Copy full prompt text to clipboard"
              >
                Copy Prompt
              </button>
            </div>
            <pre class="prompt-pre"><code id={`code-${p.id}`}>{p.content}</code></pre>
          </div>

          <div class="section-block schema-block">
            <div class="section-label-bar">
              <span class="section-label">&#128221; Expected Output Structure / Contract</span>
            </div>
            <div class="output-format-box">
              <code>{p.outputFormat}</code>
            </div>
          </div>
        </div>

        <div class="card-footer">
          <span class="footer-meta">
            Immutable Editorial Baseline &bull; Mode: <strong>Zero Hallucination Grounding</strong>
          </span>
          <a href="/admin/ai" class="btn btn-secondary btn-sm">
            View Live Telemetry Runs &rarr;
          </a>
        </div>
      </div>
    ))}
  </div>
</AdminLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.btn-copy-prompt').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;

        const codeEl = document.getElementById(targetId);
        if (!codeEl) return;

        try {
          await navigator.clipboard.writeText(codeEl.innerText);
          const originalText = btn.innerText;
          btn.innerText = '✓ Copied!';
          btn.style.color = '#15803d';
          setTimeout(() => {
            btn.innerText = originalText;
            btn.style.color = '';
          }, 2000);
        } catch (err) {
          // Fallback
        }
      });
    });
  });
</script>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .back-link {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .page-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    max-width: 780px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .stat-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .stat-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--color-text-main);
  }

  .text-success { color: #15803d; }
  .text-accent { color: #2563eb; }

  .prompts-container {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .prompt-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .card-header {
    padding: 1.25rem 1.5rem;
    background-color: var(--color-surface-subtle);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .header-main-info {
    flex: 1;
  }

  .stage-tag-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .badge-stage {
    background-color: #eff6ff;
    color: #1e40af;
    border: 1px solid #bfdbfe;
    font-weight: 700;
    font-size: 0.6875rem;
  }

  .model-badge {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .prompt-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin: 0 0 0.35rem 0;
  }

  .prompt-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.45;
  }

  .header-badges {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .version-pill {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-main);
    font-weight: 600;
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .section-label-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .section-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .btn-copy-prompt {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-brand-accent);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-copy-prompt:hover {
    background-color: var(--color-surface-subtle);
    border-color: var(--color-border-dark);
  }

  .prompt-pre {
    background-color: #0f172a;
    color: #f8fafc;
    padding: 1.25rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-height: 360px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .output-format-box {
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    color: var(--color-text-main);
  }

  .card-footer {
    padding: 0.875rem 1.5rem;
    background-color: var(--color-surface-subtle);
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer-meta {
    font-size: 0.75rem;
    color: var(--color-text-dim);
  }

  .alert {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }

  .alert-success {
    background-color: #dcfce7;
    color: #166534;
    border: 1px solid #bbf7d0;
  }

  .alert-danger {
    background-color: #fee2e2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  @media (max-width: 860px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .card-header {
      flex-direction: column;
    }

    .card-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 540px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
