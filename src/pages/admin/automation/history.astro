---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db/client';

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);

const url = new URL(Astro.request.url);
const eventFilter = url.searchParams.get('event') || '';
const page = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));
const pageSize = 30;
const offset = (page - 1) * pageSize;

let logsData = { logs: [] as any[], total: 0 };

if (dbService) {
  logsData = await dbService.listAutomationLogs({
    eventType: eventFilter || undefined,
    limit: pageSize,
    offset,
  });
}

const totalPages = Math.ceil(logsData.total / pageSize) || 1;

function formatDate(ts: number | null): string {
  if (!ts) return '—';
  return new Date(ts).toLocaleString('en-US', {
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  });
}

function getEventBadge(eventType: string): { label: string; class: string } {
  if (eventType.includes('COMPLETED') || eventType.includes('PUBLISHED')) return { label: eventType, class: 'badge-success' };
  if (eventType.includes('FAILED') || eventType.includes('ERROR')) return { label: eventType, class: 'badge-danger' };
  if (eventType.includes('PAUSED') || eventType.includes('REVIEW')) return { label: eventType, class: 'badge-warning' };
  return { label: eventType, class: 'badge-neutral' };
}
---

<AdminLayout title="Automation Logs" currentPath="/admin/automation">
  <div class="page-header">
    <div>
      <a href="/admin/automation" class="back-link">&larr; Back to Pipeline</a>
      <h1 class="page-title">Automation Audit Logs</h1>
      <p class="page-description">Historical execution telemetry across Cron, Queue events, AI generation, and publishing actions.</p>
    </div>
  </div>

  <div class="filter-panel">
    <form method="GET" class="filter-form">
      <div class="filter-group">
        <select name="event" class="form-input filter-select" onchange="this.form.submit()">
          <option value="">All Event Types</option>
          <option value="CYCLE_STARTED" selected={eventFilter === 'CYCLE_STARTED'}>CYCLE_STARTED</option>
          <option value="CYCLE_COMPLETED" selected={eventFilter === 'CYCLE_COMPLETED'}>CYCLE_COMPLETED</option>
          <option value="SOURCE_SCHEDULED" selected={eventFilter === 'SOURCE_SCHEDULED'}>SOURCE_SCHEDULED</option>
          <option value="SOURCE_INGEST_COMPLETED" selected={eventFilter === 'SOURCE_INGEST_COMPLETED'}>SOURCE_INGEST_COMPLETED</option>
          <option value="ARTICLE_SENT_TO_REVIEW" selected={eventFilter === 'ARTICLE_SENT_TO_REVIEW'}>ARTICLE_SENT_TO_REVIEW</option>
          <option value="ARTICLE_PUBLISHED" selected={eventFilter === 'ARTICLE_PUBLISHED'}>ARTICLE_PUBLISHED</option>
          <option value="JOB_FAILED" selected={eventFilter === 'JOB_FAILED'}>JOB_FAILED</option>
          <option value="AI_FAILED" selected={eventFilter === 'AI_FAILED'}>AI_FAILED</option>
        </select>
      </div>

      <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
      {eventFilter && (
        <a href="/admin/automation/history" class="btn btn-secondary btn-sm">Reset</a>
      )}
    </form>
  </div>

  <div class="table-card">
    <div class="card-header">
      <h2 class="card-title">Event Trail ({logsData.total})</h2>
    </div>

    {logsData.logs.length === 0 ? (
      <div class="empty-box">
        <p class="empty-text">No automation logs yet.</p>
        <span class="empty-subtext">Events will be logged as the pipeline executes Cron evaluations and processing runs.</span>
      </div>
    ) : (
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>Event</th>
              <th>Target Entity</th>
              <th>Message</th>
            </tr>
          </thead>
          <tbody>
            {logsData.logs.map((log) => {
              const badge = getEventBadge(log.event_type);
              return (
                <tr>
                  <td>
                    <span class="date-text">{formatDate(log.created_at)}</span>
                  </td>
                  <td>
                    <span class:list={['badge', badge.class]}>{badge.label}</span>
                  </td>
                  <td>
                    {log.entity_type ? (
                      <span class="entity-badge">{log.entity_type}: {log.entity_id?.slice(0, 10)}</span>
                    ) : (
                      <span class="text-dim">—</span>
                    )}
                  </td>
                  <td>
                    <span class="log-message">{log.message}</span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}

    {totalPages > 1 && (
      <div class="pagination">
        {page > 1 && (
          <a href={`?page=${page - 1}&event=${eventFilter}`} class="btn btn-secondary btn-sm">
            &larr; Previous
          </a>
        )}
        <span class="page-info">Page {page} of {totalPages}</span>
        {page < totalPages && (
          <a href={`?page=${page + 1}&event=${eventFilter}`} class="btn btn-secondary btn-sm">
            Next &rarr;
          </a>
        )}
      </div>
    )}
  </div>
</AdminLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
  }

  .back-link {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .page-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .filter-panel {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
  }

  .filter-form {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .filter-select {
    width: auto;
    min-width: 200px;
    font-size: 0.8125rem;
    padding: 0.5rem 0.75rem;
  }

  .table-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .card-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .admin-table th {
    text-align: left;
    padding: 0.75rem 1.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    background-color: var(--color-surface-subtle);
    border-bottom: 1px solid var(--color-border);
  }

  .admin-table td {
    padding: 0.875rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  .date-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .entity-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.15rem 0.4rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .text-dim {
    color: var(--color-text-dim);
  }

  .log-message {
    font-size: 0.8125rem;
    color: var(--color-text-main);
  }

  .btn-sm {
    padding: 0.35rem 0.75rem;
    font-size: 0.8125rem;
  }

  .empty-box {
    padding: 4rem 2rem;
    text-align: center;
  }

  .empty-text {
    font-size: 1rem;
    font-weight: 600;
  }

  .empty-subtext {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .page-info {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
</style>
