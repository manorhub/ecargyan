---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db/client';

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);
if (!dbService) return Astro.redirect('/admin', 302);

let successMessage = '';
let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const globalStatus = (formData.get('global_status') as string || 'running').trim();
    const stageIngestion = formData.get('stage_ingestion') === 'on' ? 'true' : 'false';
    const stageProcessing = formData.get('stage_processing') === 'on' ? 'true' : 'false';
    const stageAiGeneration = formData.get('stage_ai_generation') === 'on' ? 'true' : 'false';
    const autoPublish = formData.get('auto_publish') === 'on' ? 'true' : 'false';
    const maxArticlesPerDay = (formData.get('max_articles_per_day') as string || '5').trim();
    const maxAiRunsPerHour = (formData.get('max_ai_runs_per_hour') as string || '10').trim();
    const minGapBetweenArticles = (formData.get('min_gap_between_articles_minutes') as string || '60').trim();
    const minQualityScore = (formData.get('min_quality_score_for_auto_publish') as string || '85').trim();

    await dbService.updateAutomationSettings({
      global_status: globalStatus,
      stage_ingestion: stageIngestion,
      stage_processing: stageProcessing,
      stage_ai_generation: stageAiGeneration,
      auto_publish: autoPublish,
      max_articles_per_day: maxArticlesPerDay,
      max_ai_runs_per_hour: maxAiRunsPerHour,
      min_gap_between_articles_minutes: minGapBetweenArticles,
      min_quality_score_for_auto_publish: minQualityScore,
    });

    if (Astro.locals.admin) {
      await dbService.logAudit(Astro.locals.admin.id, 'update_automation_settings', 'automation_settings', 'global', { globalStatus, autoPublish });
    }

    successMessage = 'Automation pipeline settings updated successfully.';
  } catch (err: any) {
    errorMessage = err.message || 'Failed to update automation settings.';
  }
}

const currentSettings = await dbService.getAutomationSettings();
---

<AdminLayout title="Automation Settings" currentPath="/admin/automation">
  <div class="page-header">
    <div>
      <a href="/admin/automation" class="back-link">&larr; Back to Pipeline</a>
      <h1 class="page-title">Automation & Publishing Settings</h1>
      <p class="page-description">Configure autonomous cron schedules, stage toggles, daily quotas, and auto-publishing safety guards.</p>
    </div>
  </div>

  {successMessage && <div class="alert alert-success">{successMessage}</div>}
  {errorMessage && <div class="alert alert-danger">{errorMessage}</div>}

  <div class="settings-grid">
    <form method="POST" class="settings-form">
      <!-- Master Switch & Stage Toggles -->
      <div class="card">
        <h2 class="card-title">Pipeline Master Switch & Stages</h2>

        <div class="form-group">
          <label for="global_status" class="form-label">Master Automation Status</label>
          <select id="global_status" name="global_status" class="form-input">
            <option value="running" selected={currentSettings['global_status'] === 'running' || !currentSettings['global_status']}>
              RUNNING (Execute Cron and Queue Workers)
            </option>
            <option value="paused" selected={currentSettings['global_status'] === 'paused'}>
              PAUSED (Halt All Automated Job Scheduling)
            </option>
          </select>
        </div>

        <div class="stage-checkboxes">
          <label class="checkbox-label">
            <input type="checkbox" name="stage_ingestion" checked={currentSettings['stage_ingestion'] !== 'false'} />
            <span>Enable Source Discovery & Ingestion Stage</span>
          </label>

          <label class="checkbox-label">
            <input type="checkbox" name="stage_processing" checked={currentSettings['stage_processing'] !== 'false'} />
            <span>Enable Content Processing & Deduplication Stage</span>
          </label>

          <label class="checkbox-label">
            <input type="checkbox" name="stage_ai_generation" checked={currentSettings['stage_ai_generation'] !== 'false'} />
            <span>Enable DeepSeek AI Editorial Drafting Stage</span>
          </label>
        </div>
      </div>

      <!-- Auto Publishing Guard (Mandatory Default OFF) -->
      <div class="card safety-card">
        <h2 class="card-title">Publishing Mode & Safety Guard</h2>

        <div class="form-group checkbox-group">
          <label class="checkbox-label highlight-checkbox">
            <input type="checkbox" name="auto_publish" checked={currentSettings['auto_publish'] === 'true'} />
            <span><strong>Enable Automatic Publishing</strong> (Default is OFF / Review Mode)</span>
          </label>
          <p class="field-hint">
            When OFF (recommended), all AI drafts are saved to CMS with <code>status = 'review'</code>. When ON, articles are published automatically only if all deterministic SEO, uniqueness, and quality criteria pass.
          </p>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="min_quality_score_for_auto_publish" class="form-label">Min Quality Score for Auto-Publish (0–100)</label>
            <input
              type="number"
              id="min_quality_score_for_auto_publish"
              name="min_quality_score_for_auto_publish"
              class="form-input"
              min="70"
              max="100"
              value={currentSettings['min_quality_score_for_auto_publish'] || '85'}
            />
          </div>

          <div class="form-group">
            <label for="min_gap_between_articles_minutes" class="form-label">Min Pacing Gap (Minutes)</label>
            <input
              type="number"
              id="min_gap_between_articles_minutes"
              name="min_gap_between_articles_minutes"
              class="form-input"
              min="0"
              max="1440"
              value={currentSettings['min_gap_between_articles_minutes'] || '60'}
            />
          </div>
        </div>
      </div>

      <!-- Rate Limits & Quotas -->
      <div class="card">
        <h2 class="card-title">Daily Quotas & Rate Limits</h2>

        <div class="form-row">
          <div class="form-group">
            <label for="max_articles_per_day" class="form-label">Max Articles Published Per Day</label>
            <input
              type="number"
              id="max_articles_per_day"
              name="max_articles_per_day"
              class="form-input"
              min="1"
              max="50"
              value={currentSettings['max_articles_per_day'] || '5'}
            />
          </div>

          <div class="form-group">
            <label for="max_ai_runs_per_hour" class="form-label">Max AI Generations Per Hour</label>
            <input
              type="number"
              id="max_ai_runs_per_hour"
              name="max_ai_runs_per_hour"
              class="form-input"
              min="1"
              max="100"
              value={currentSettings['max_ai_runs_per_hour'] || '10'}
            />
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save Pipeline Settings</button>
          <a href="/admin/automation" class="btn btn-secondary">Cancel</a>
        </div>
      </div>
    </form>
  </div>
</AdminLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
  }

  .back-link {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .page-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .settings-grid {
    max-width: 760px;
  }

  .settings-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.75rem;
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .safety-card {
    border-left: 4px solid var(--color-warning);
  }

  .stage-checkboxes {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .highlight-checkbox {
    font-size: 0.9375rem;
  }

  .field-hint {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 0.4rem;
    line-height: 1.4;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }

  .form-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .alert {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }

  .alert-success {
    background-color: var(--color-success-bg);
    color: var(--color-success);
    border: 1px solid #bbf7d0;
  }

  .alert-danger {
    background-color: var(--color-danger-bg);
    color: var(--color-danger);
    border: 1px solid #fecaca;
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
