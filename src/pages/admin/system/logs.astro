---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db/client';

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);
if (!dbService) return Astro.redirect('/admin', 302);

const url = new URL(Astro.request.url);
const eventFilter = url.searchParams.get('event') || '';
const page = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));
const pageSize = 30;
const offset = (page - 1) * pageSize;

const { logs, total } = await dbService.listAutomationLogs({
  eventType: eventFilter || undefined,
  limit: pageSize,
  offset,
});

const totalPages = Math.ceil(total / pageSize) || 1;

function formatDate(ts: number): string {
  return new Date(ts).toLocaleString('en-US', {
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  });
}
---

<AdminLayout title="Operational Logs" currentPath="/admin/system/logs">
  <div class="page-header">
    <div>
      <h1 class="page-title">Operational System Logs</h1>
      <p class="page-description">Immutable log stream tracking cron executions, ingestion events, AI runs, and failures.</p>
    </div>
  </div>

  <!-- Filter Bar -->
  <div class="filter-panel">
    <form method="GET" class="filter-form">
      <div class="filter-group">
        <select name="event" class="form-input filter-select" onchange="this.form.submit()">
          <option value="" selected={!eventFilter}>All Event Types</option>
          <option value="cron_trigger" selected={eventFilter === 'cron_trigger'}>Cron Scheduler</option>
          <option value="source_discovery" selected={eventFilter === 'source_discovery'}>Source Discovery</option>
          <option value="ingestion_completed" selected={eventFilter === 'ingestion_completed'}>Ingestion Completed</option>
          <option value="ai_run_completed" selected={eventFilter === 'ai_run_completed'}>AI Generation</option>
          <option value="job_failed" selected={eventFilter === 'job_failed'}>Job Failures</option>
          <option value="emergency_stop" selected={eventFilter === 'emergency_stop'}>Emergency Stops</option>
        </select>
      </div>
    </form>
  </div>

  <div class="table-card">
    <div class="card-header">
      <h2 class="card-title">Activity Stream ({total})</h2>
    </div>

    {logs.length === 0 ? (
      <div class="empty-box">
        <p class="empty-text">No logs found matching criteria.</p>
        <span class="empty-subtext">Operational logs will be recorded as jobs are processed.</span>
      </div>
    ) : (
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>Event Type</th>
              <th>Entity</th>
              <th>Message</th>
            </tr>
          </thead>
          <tbody>
            {logs.map((log: any) => (
              <tr>
                <td><span class="date-text">{formatDate(log.created_at)}</span></td>
                <td><span class="badge badge-neutral">{log.event_type}</span></td>
                <td>
                  <span class="entity-text">
                    {log.entity_type ? `${log.entity_type}:${log.entity_id?.slice(0, 8)}` : '—'}
                  </span>
                </td>
                <td><span class="log-msg">{log.message}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {totalPages > 1 && (
      <div class="pagination">
        {page > 1 && (
          <a href={`/admin/system/logs?page=${page - 1}&event=${eventFilter}`} class="btn btn-secondary btn-sm">
            &larr; Previous
          </a>
        )}
        <span class="page-info">Page {page} of {totalPages}</span>
        {page < totalPages && (
          <a href={`/admin/system/logs?page=${page + 1}&event=${eventFilter}`} class="btn btn-secondary btn-sm">
            Next &rarr;
          </a>
        )}
      </div>
    )}
  </div>
</AdminLayout>

<style>
  .page-header {
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .page-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .filter-panel {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
  }

  .filter-select {
    width: auto;
    min-width: 220px;
    font-size: 0.8125rem;
    padding: 0.5rem 0.75rem;
  }

  .table-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .card-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .admin-table th {
    text-align: left;
    padding: 0.75rem 1.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background-color: var(--color-surface-subtle);
    border-bottom: 1px solid var(--color-border);
  }

  .admin-table td {
    padding: 0.75rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  .date-text, .entity-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .log-msg {
    color: var(--color-text-main);
    font-size: 0.8125rem;
  }

  .empty-box {
    padding: 4rem 2rem;
    text-align: center;
  }

  .empty-text {
    font-size: 1rem;
    font-weight: 600;
  }

  .empty-subtext {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .page-info {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
</style>
