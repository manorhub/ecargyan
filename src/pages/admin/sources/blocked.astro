---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db/client';

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);

const url = new URL(Astro.request.url);
const page = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));
const pageSize = 30;
const offset = (page - 1) * pageSize;

let blockedData = { sources: [] as any[], total: 0 };
if (dbService) {
  blockedData = await dbService.listBlockedSources(pageSize, offset);
}

function formatDate(ts: number | null): string {
  if (!ts) return 'Never';
  return new Date(ts).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<AdminLayout title="Blocked Sources" currentPath="/admin/sources/blocked">
  <div class="page-header">
    <div>
      <div class="breadcrumb-trail">
        <a href="/admin/sources">Sources</a>
        <span class="sep">/</span>
        <span>Blocked Sources</span>
      </div>
      <h1 class="page-title">Source Policy Blocklist ({blockedData.total})</h1>
      <p class="page-description">
        Sources explicitly excluded from all automated ingestion, research pooling, DeepSeek AI synthesis, and publishing.
      </p>
    </div>
    <div class="header-actions">
      <a href="/admin/sources" class="btn btn-secondary">All Sources</a>
      <a href="/admin/sources/whitelist" class="btn btn-secondary">View Whitelist</a>
    </div>
  </div>

  <!-- Block Policy Guarantee Card -->
  <div class="block-guarantee-card">
    <div class="guarantee-icon">🛡️</div>
    <div>
      <strong>Strict Blocklist Enforcement</strong>
      <p>
        Blocked sources are hard-gated: Cron schedulers skip them, manual fetches abort immediately, AI prompts filter them out, and publishing guards reject any derived content. Historical records are preserved for audit purposes.
      </p>
    </div>
  </div>

  <div class="table-card">
    <div class="card-header">
      <h2 class="card-title">Blocked Sources ({blockedData.total})</h2>
    </div>

    {blockedData.sources.length === 0 ? (
      <div class="empty-box">
        <p class="empty-text">No sources are currently blocked.</p>
        <span class="empty-subtext">When a source's terms prohibit automated reuse, mark it as BLOCKED in the policy editor.</span>
      </div>
    ) : (
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Source Name</th>
              <th>Type</th>
              <th>Status</th>
              <th>Blocked By</th>
              <th>Evaluation Notes</th>
              <th>Blocked At</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            {blockedData.sources.map((src) => (
              <tr>
                <td>
                  <a href={`/admin/sources/${src.source_id}/policy`} class="source-title-link">
                    {src.source_name}
                  </a>
                  <span class="source-url-hint">{src.source_url}</span>
                </td>
                <td>
                  <span class="type-badge">{(src.source_type || 'rss').toUpperCase()}</span>
                </td>
                <td>
                  <span class="badge badge-danger">BLOCKED</span>
                </td>
                <td>
                  <span class="email-text">{src.reviewed_by_email || 'Administrator'}</span>
                </td>
                <td>
                  <span class="notes-preview">{src.policy_notes || 'No evaluation notes recorded.'}</span>
                </td>
                <td>
                  <span class="date-text">{formatDate(src.last_reviewed_at)}</span>
                </td>
                <td class="text-right">
                  <div class="actions-group">
                    <a href={`/admin/sources/${src.source_id}/policy`} class="btn btn-primary btn-xs">
                      Edit Policy
                    </a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>

<style>
  .breadcrumb-trail {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .breadcrumb-trail a { color: var(--color-text-muted); text-decoration: none; }
  .breadcrumb-trail a:hover { color: var(--color-brand-primary); }
  .sep { color: var(--color-border); }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .page-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .header-actions { display: flex; gap: 0.75rem; }

  .block-guarantee-card {
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 1.5rem;
  }

  .guarantee-icon { font-size: 1.5rem; line-height: 1; }
  .block-guarantee-card strong { color: #991b1b; font-size: 0.875rem; display: block; margin-bottom: 0.25rem; }
  .block-guarantee-card p { color: #b91c1c; font-size: 0.8125rem; margin: 0; line-height: 1.4; }

  .table-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .card-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .card-title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
  }

  .table-responsive {
    width: 100%;
    overflow-x: auto;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: left;
  }

  .admin-table th {
    padding: 0.75rem 1.25rem;
    background-color: var(--color-bg);
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--color-border);
  }

  .admin-table td {
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  .admin-table tbody tr:hover {
    background-color: rgba(0, 0, 0, 0.015);
  }

  .source-title-link {
    font-weight: 600;
    color: var(--color-text-main);
    text-decoration: none;
    display: block;
  }

  .source-title-link:hover {
    color: var(--color-brand-accent);
  }

  .source-url-hint {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    display: block;
    max-width: 250px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .type-badge {
    font-size: 0.6875rem;
    font-weight: 700;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.4rem;
    border-radius: var(--radius-sm);
  }

  .notes-preview {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    display: block;
    max-width: 300px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .email-text {
    font-size: 0.8125rem;
    color: var(--color-text-main);
  }

  .actions-group {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }

  .btn-xs {
    padding: 0.25rem 0.55rem;
    font-size: 0.75rem;
  }

  .empty-box {
    padding: 4rem 2rem;
    text-align: center;
  }

  .empty-text {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .empty-subtext {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
</style>
