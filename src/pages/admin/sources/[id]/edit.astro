---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb } from '../../../../lib/db/client';
import { validateOutboundUrl } from '../../../../lib/sources/security';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/sources', 302);

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);
if (!dbService) return Astro.redirect('/admin/sources', 302);

const source = await dbService.getSourceById(id);
if (!source) return Astro.redirect('/admin/sources', 302);

let errorMessage = '';
const categories = await dbService.listCategories();

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const name = (formData.get('name') as string || '').trim();
    const baseUrl = (formData.get('base_url') as string || '').trim();
    const sourceType = (formData.get('source_type') as string || 'rss').trim();
    const rssUrl = (formData.get('rss_url') as string || '').trim();
    const description = (formData.get('description') as string || '').trim();
    const categoryId = (formData.get('category_id') as string || '').trim() || null;
    const priority = parseInt(formData.get('priority') as string || '1', 10);
    const fetchInterval = parseInt(formData.get('fetch_interval') as string || '3600', 10);
    const status = (formData.get('status') as string || 'active').trim();

    if (!name || !baseUrl) {
      errorMessage = 'Source name and base URL are required.';
    } else {
      const baseCheck = validateOutboundUrl(baseUrl);
      if (!baseCheck.valid) {
        errorMessage = `Base URL Error: ${baseCheck.error}`;
      } else {
        if (rssUrl) {
          const rssCheck = validateOutboundUrl(rssUrl);
          if (!rssCheck.valid) {
            errorMessage = `RSS URL Error: ${rssCheck.error}`;
          }
        }

        if (!errorMessage) {
          await dbService.updateSource(id, {
            name,
            base_url: baseUrl,
            source_type: sourceType,
            rss_url: rssUrl || null,
            description: description || null,
            category_id: categoryId,
            priority,
            fetch_interval: fetchInterval,
            status,
          });

          if (Astro.locals.admin) {
            await dbService.logAudit(Astro.locals.admin.id, 'update_source', 'source', id, { name, rssUrl });
          }

          return Astro.redirect(`/admin/sources/${id}?success=Configuration+updated`, 302);
        }
      }
    }
  } catch (err: any) {
    errorMessage = err.message || 'Failed to update source.';
  }
}
---

<AdminLayout title={`Edit: ${source.name}`} currentPath="/admin/sources">
  <div class="page-header">
    <a href={`/admin/sources/${source.id}`} class="back-link">&larr; Back to Source Details</a>
    <h1 class="page-title">Edit Source Configuration</h1>
  </div>

  {errorMessage && <div class="alert alert-danger">{errorMessage}</div>}

  <div class="form-layout">
    <form method="POST" class="source-form">
      <div class="form-card">
        <h2 class="card-title">Source Credentials</h2>

        <div class="form-group">
          <label for="name" class="form-label">Source Name *</label>
          <input
            type="text"
            id="name"
            name="name"
            class="form-input"
            value={source.name}
            required
          />
        </div>

        <div class="form-group">
          <label for="base_url" class="form-label">Base Publication URL *</label>
          <input
            type="url"
            id="base_url"
            name="base_url"
            class="form-input"
            value={source.base_url}
            required
          />
        </div>

        <div class="form-group">
          <label for="source_type" class="form-label">Ingestion Protocol</label>
          <select id="source_type" name="source_type" class="form-input">
            <option value="rss" selected={source.source_type === 'rss'}>RSS / Atom Feed</option>
            <option value="website" selected={source.source_type === 'website'}>Website (Direct Ingestion)</option>
            <option value="api" selected={source.source_type === 'api'}>API Endpoint</option>
          </select>
        </div>

        <div class="form-group">
          <label for="rss_url" class="form-label">RSS / Atom Endpoint URL</label>
          <input
            type="url"
            id="rss_url"
            name="rss_url"
            class="form-input"
            value={source.rss_url || ''}
          />
        </div>

        <div class="form-group">
          <label for="description" class="form-label">Description / Coverage Focus</label>
          <textarea
            id="description"
            name="description"
            class="form-input"
            rows="2"
          >{source.description || ''}</textarea>
        </div>
      </div>

      <div class="form-card">
        <h2 class="card-title">Classification & Pipeline Policy</h2>

        <div class="form-group">
          <label for="category_id" class="form-label">Target Category</label>
          <select id="category_id" name="category_id" class="form-input">
            <option value="">— Unclassified —</option>
            {categories.map((c) => (
              <option value={c.id} selected={source.category_id === c.id}>{c.name}</option>
            ))}
          </select>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="priority" class="form-label">Priority</label>
            <select id="priority" name="priority" class="form-input">
              <option value="3" selected={source.priority === 3}>High (Priority 3)</option>
              <option value="2" selected={source.priority === 2}>Normal (Priority 2)</option>
              <option value="1" selected={source.priority === 1}>Standard (Priority 1)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="fetch_interval" class="form-label">Fetch Frequency</label>
            <select id="fetch_interval" name="fetch_interval" class="form-input">
              <option value="900" selected={source.fetch_interval === 900}>Every 15 minutes</option>
              <option value="1800" selected={source.fetch_interval === 1800}>Every 30 minutes</option>
              <option value="3600" selected={source.fetch_interval === 3600}>Every 1 hour</option>
              <option value="10800" selected={source.fetch_interval === 10800}>Every 3 hours</option>
              <option value="21600" selected={source.fetch_interval === 21600}>Every 6 hours</option>
              <option value="43200" selected={source.fetch_interval === 43200}>Every 12 hours</option>
              <option value="86400" selected={source.fetch_interval === 86400}>Every 24 hours</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="status" class="form-label">Status</label>
          <select id="status" name="status" class="form-input">
            <option value="active" selected={source.status === 'active'}>Active</option>
            <option value="paused" selected={source.status === 'paused'}>Paused</option>
            <option value="disabled" selected={source.status === 'disabled'}>Disabled</option>
          </select>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save Changes</button>
          <a href={`/admin/sources/${source.id}`} class="btn btn-secondary">Cancel</a>
        </div>
      </div>
    </form>
  </div>
</AdminLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
  }

  .back-link {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
  }

  .form-layout {
    max-width: 720px;
  }

  .source-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.75rem;
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .alert {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }

  .alert-danger {
    background-color: var(--color-danger-bg);
    color: var(--color-danger);
    border: 1px solid #fecaca;
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
