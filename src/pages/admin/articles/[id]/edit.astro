---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import MarkdownLinkingToolbar from '../../../../components/admin/MarkdownLinkingToolbar.astro';
import { getDb } from '../../../../lib/db/client';
import { getUniqueSlug } from '../../../../lib/db/slug';
import { validateArticleInput } from '../../../../lib/utils/validation';
import { InternalLinkingEngine } from '../../../../lib/seo/linking';
import type { ArticleStatus } from '../../../../lib/db/schema';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/articles', 302);

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);
if (!dbService) return Astro.redirect('/admin/articles', 302);

const article = await dbService.getArticleById(id);
if (!article) return Astro.redirect('/admin/articles', 302);

let errorMessage = '';

const linkingEngine = runtimeEnv?.DB ? new InternalLinkingEngine(runtimeEnv.DB) : null;

const [categories, authors, tags, mediaList, articleImages, recommendedLinks] = await Promise.all([
  dbService.listCategories(),
  dbService.listAuthors(),
  dbService.listTags(),
  dbService.listMedia(50, 0),
  dbService.getArticleImages(id),
  linkingEngine ? linkingEngine.findLinkCandidates(id, {
    categoryId: article.category_id,
    titleKeywords: article.title.split(' '),
    limit: 5,
    minRelevance: 0,
  }) : Promise.resolve([]),
]);

const activeImage = articleImages.find((i) => i.is_featured === 1) || null;
const currentTagIds = new Set((article.tags || []).map((t) => t.id));

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const title = (formData.get('title') as string || '').trim();
    const customSlug = (formData.get('slug') as string || '').trim();
    const excerpt = (formData.get('excerpt') as string || '').trim();
    const content = (formData.get('content') as string || '').trim();
    const status = (formData.get('status') as ArticleStatus || 'draft');
    const categoryId = (formData.get('category_id') as string || '').trim() || null;
    const authorId = (formData.get('author_id') as string || '').trim() || null;
    const featuredImageId = (formData.get('featured_image_id') as string || '').trim() || null;
    const scheduledAtStr = formData.get('scheduled_at') as string;
    const scheduledAt = scheduledAtStr ? new Date(scheduledAtStr).getTime() : null;

    const selectedTagIds = formData.getAll('tag_ids') as string[];

    // SEO
    const metaTitle = (formData.get('meta_title') as string || '').trim() || null;
    const metaDescription = (formData.get('meta_description') as string || '').trim() || null;
    const canonicalUrl = (formData.get('canonical_url') as string || '').trim() || null;
    const ogTitle = (formData.get('og_title') as string || '').trim() || null;
    const ogDescription = (formData.get('og_description') as string || '').trim() || null;

    const validation = validateArticleInput({ title, content, status, scheduled_at: scheduledAt });
    if (!validation.valid) {
      errorMessage = Object.values(validation.errors)[0] || 'Validation error.';
    } else {
      const slug = customSlug
        ? await getUniqueSlug(runtimeEnv!.DB, 'articles', customSlug, id)
        : await getUniqueSlug(runtimeEnv!.DB, 'articles', title, id);

      await dbService.updateArticle(id, {
        title,
        slug,
        excerpt: excerpt || null,
        content,
        status,
        author_id: authorId,
        category_id: categoryId,
        featured_image_id: featuredImageId,
        scheduled_at: scheduledAt,
        tagIds: selectedTagIds,
        seo: {
          meta_title: metaTitle,
          meta_description: metaDescription,
          canonical_url: canonicalUrl,
          og_title: ogTitle,
          og_description: ogDescription,
          og_image_id: featuredImageId,
        },
      });

      // Phase 9: Record immutable revision snapshot
      if (runtimeEnv?.DB) {
        const { ArticleRevisionService } = await import('../../../../lib/admin/revisions');
        const revService = new ArticleRevisionService(runtimeEnv.DB);
        await revService.createRevision(
          id,
          { title, excerpt: excerpt || null, content, categoryId, status },
          Astro.locals.admin?.id || null,
          status === 'published' ? 'publish' : 'save'
        );
      }

      if (Astro.locals.admin) {
        await dbService.logAudit(Astro.locals.admin.id, 'update_article', 'article', id, { title, slug, status });
      }

      // Automatic IndexNow ping on publish
      if (status === 'published' && runtimeEnv?.DB) {
        try {
          const { IndexNowService } = await import('../../../../lib/seo/indexnow');
          const indexNow = new IndexNowService();
          await indexNow.submitArticle(slug, { db: runtimeEnv.DB, adminId: Astro.locals.admin?.id });
        } catch (e) {
          // Log error but don't fail article save
        }
      }

      return Astro.redirect('/admin/articles', 302);
    }
  } catch (err) {
    errorMessage = 'Failed to update article.';
  }
}

const revisions = await dbService.listArticleRevisions(id);

function toDatetimeInput(ts: number | null): string {
  if (!ts) return '';
  const d = new Date(ts);
  d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
  return d.toISOString().slice(0, 16);
}
---

<AdminLayout title={`Edit: ${article.title}`} currentPath="/admin/articles">
  <div class="page-header">
    <div class="header-left">
      <a href="/admin/articles" class="back-link">&larr; Back to Articles</a>
      <h1 class="page-title">Edit Article</h1>
    </div>
    <div class="header-right">
      <a href={`/admin/articles/${article.id}/preview`} class="btn btn-secondary" target="_blank">
        Preview Draft &nearr;
      </a>
    </div>
  </div>

  {errorMessage && <div class="alert alert-danger">{errorMessage}</div>}

  <form method="POST" class="editor-form">
    <div class="editor-layout">
      <!-- Main Content Column -->
      <div class="editor-main">
        <div class="editor-card">
          <div class="form-group">
            <label for="title" class="form-label">Article Title *</label>
            <input
              type="text"
              id="title"
              name="title"
              class="form-input title-input"
              value={article.title}
              required
            />
          </div>

          <div class="form-group">
            <label for="slug" class="form-label">URL Slug</label>
            <input
              type="text"
              id="slug"
              name="slug"
              class="form-input"
              value={article.slug}
              required
            />
          </div>

          <div class="form-group">
            <label for="excerpt" class="form-label">Article Excerpt / Deck</label>
            <textarea
              id="excerpt"
              name="excerpt"
              class="form-input"
              rows="2"
            >{article.excerpt || ''}</textarea>
          </div>

          <div class="form-group">
            <label for="content" class="form-label">Article Body (Markdown) *</label>
            <MarkdownLinkingToolbar textareaId="content" currentArticleId={article.id} categoryId={article.category_id} />
            <textarea
              id="content"
              name="content"
              class="form-input content-textarea"
              rows="18"
              required
            >{article.content}</textarea>
          </div>
        </div>

        <!-- SEO Metadata Card -->
        <div class="editor-card">
          <h2 class="card-title">SEO & OpenGraph Configuration</h2>
          
          <div class="form-group">
            <label for="meta_title" class="form-label">Meta Title</label>
            <input
              type="text"
              id="meta_title"
              name="meta_title"
              class="form-input"
              value={article.seo?.meta_title || ''}
              placeholder="Optimal length: ~50-60 characters"
            />
          </div>

          <div class="form-group">
            <label for="meta_description" class="form-label">Meta Description</label>
            <textarea
              id="meta_description"
              name="meta_description"
              class="form-input"
              rows="2"
              placeholder="Optimal length: ~120-155 characters"
            >{article.seo?.meta_description || ''}</textarea>
          </div>

          <div class="form-group">
            <label for="canonical_url" class="form-label">Canonical URL</label>
            <input
              type="url"
              id="canonical_url"
              name="canonical_url"
              class="form-input"
              value={article.seo?.canonical_url || ''}
              placeholder="https://ecargyan.com/article/..."
            />
          </div>
        </div>
      </div>

      <!-- Sidebar Column -->
      <div class="editor-sidebar">
        <!-- Publishing Control -->
        <div class="sidebar-card">
          <h2 class="card-title">Publishing Status</h2>
          
          <div class="form-group">
            <label for="status" class="form-label">Workflow Status</label>
            <select id="status" name="status" class="form-input">
              <option value="draft" selected={article.status === 'draft'}>Draft</option>
              <option value="review" selected={article.status === 'review'}>In Review</option>
              <option value="scheduled" selected={article.status === 'scheduled'}>Scheduled</option>
              <option value="published" selected={article.status === 'published'}>Published</option>
              <option value="archived" selected={article.status === 'archived'}>Archived</option>
            </select>
          </div>

          <div class="form-group">
            <label for="scheduled_at" class="form-label">Schedule Date</label>
            <input
              type="datetime-local"
              id="scheduled_at"
              name="scheduled_at"
              class="form-input"
              value={toDatetimeInput(article.scheduled_at)}
            />
            <span class="field-hint">Required only if status is Scheduled.</span>
          </div>

          {article.published_at && (
            <div class="published-meta">
              <span class="meta-label">Published on:</span>
              <span class="meta-val">{new Date(article.published_at).toLocaleString()}</span>
            </div>
          )}

          <div class="form-actions-stack">
            <button type="submit" class="btn btn-primary btn-block">
              Save Changes
            </button>
            <a href="/admin/articles" class="btn btn-secondary btn-block">
              Cancel
            </a>
          </div>
        </div>

        <!-- Taxonomy -->
        <div class="sidebar-card">
          <h2 class="card-title">Classification</h2>

          <div class="form-group">
            <label for="category_id" class="form-label">Category</label>
            <select id="category_id" name="category_id" class="form-input">
              <option value="">— Uncategorized —</option>
              {categories.map((c) => (
                <option value={c.id} selected={article.category_id === c.id}>{c.name}</option>
              ))}
            </select>
          </div>

          <div class="form-group">
            <label for="author_id" class="form-label">Author</label>
            <select id="author_id" name="author_id" class="form-input">
              <option value="">— No Author Assigned —</option>
              {authors.map((a) => (
                <option value={a.id} selected={article.author_id === a.id}>{a.name}</option>
              ))}
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Tags</label>
            {tags.length === 0 ? (
              <span class="field-hint">No tags configured yet.</span>
            ) : (
              <div class="tags-checklist">
                {tags.map((t) => (
                  <label class="checkbox-label">
                    <input
                      type="checkbox"
                      name="tag_ids"
                      value={t.id}
                      checked={currentTagIds.has(t.id)}
                    />
                    <span>{t.name}</span>
                  </label>
                ))}
              </div>
            )}
          </div>
        </div>

        <!-- Featured Media & AI Visuals -->
        <div class="sidebar-card">
          <div class="card-header-flex">
            <h2 class="card-title">Editorial Image</h2>
            <span class="provider-badge">FLUX.1 [schnell]</span>
          </div>

          {activeImage ? (
            <div class="active-image-wrap">
              <div class="image-preview-container">
                <img
                  src={activeImage.public_url}
                  alt={activeImage.alt_text}
                  class="featured-thumb"
                />
                <span class="version-tag">v{activeImage.version}</span>
              </div>
              <div class="image-meta-info">
                <div class="meta-row">
                  <span class="meta-lbl">Model:</span>
                  <span class="meta-val">{activeImage.model}</span>
                </div>
                <div class="meta-row">
                  <span class="meta-lbl">Cost:</span>
                  <span class="meta-val">${activeImage.cost || 0}</span>
                </div>
                <div class="meta-row">
                  <span class="meta-lbl">Dimensions:</span>
                  <span class="meta-val">{activeImage.width}&times;{activeImage.height} ({activeImage.format})</span>
                </div>
                <div class="meta-row alt-row">
                  <span class="meta-lbl">Alt text:</span>
                  <span class="meta-val alt-text-preview">&ldquo;{activeImage.alt_text}&rdquo;</span>
                </div>
              </div>

              <!-- Regeneration Form -->
              <form action={`/admin/articles/${article.id}/images/generate`} method="POST" class="image-action-form">
                <input type="hidden" name="forceRegenerate" value="true" />
                <input
                  type="text"
                  name="customSubject"
                  placeholder="Custom visual tweak (optional)..."
                  class="form-input form-input-sm"
                />
                <div class="image-btn-row">
                  <button type="submit" class="btn btn-secondary btn-sm">
                    &#8635; Regenerate
                  </button>
                  <button type="submit" form="remove-img-form" class="btn btn-danger-link btn-sm">
                    Detach
                  </button>
                </div>
              </form>
              <form id="remove-img-form" action={`/admin/articles/${article.id}/images/remove`} method="POST" style="display: none;"></form>
            </div>
          ) : (
            <div class="no-image-banner">
              <p class="empty-img-text">No custom editorial image generated yet.</p>
              <form action={`/admin/articles/${article.id}/images/generate`} method="POST" class="generate-form">
                <input
                  type="text"
                  name="customSubject"
                  placeholder="Optional prompt subject override..."
                  class="form-input form-input-sm"
                />
                <button type="submit" class="btn btn-primary btn-block btn-sm">
                  &#10024; Generate with FLUX.1
                </button>
              </form>
            </div>
          )}

          {articleImages.length > 1 && (
            <div class="image-versions-history">
              <h3 class="versions-title">Version History ({articleImages.length})</h3>
              <div class="versions-list">
                {articleImages.map((img) => (
                  <div class:list={['version-item', { active: img.is_featured === 1 }]}>
                    <div class="version-meta">
                      <strong>v{img.version}</strong> &bull; {img.format} &bull; ${img.cost || 0}
                    </div>
                    {img.is_featured === 0 && (
                      <form action={`/admin/articles/${article.id}/images/set-featured`} method="POST">
                        <input type="hidden" name="imageId" value={img.id} />
                        <button type="submit" class="btn btn-outline-xs">Set Active</button>
                      </form>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          <div class="form-group select-existing-wrap">
            <label for="featured_image_id" class="form-label">Or Pick From Media Library</label>
            <select id="featured_image_id" name="featured_image_id" class="form-input form-input-sm">
              <option value="">— Use Generated Image —</option>
              {mediaList.map((m) => (
                <option value={m.id} selected={article.featured_image_id === m.id}>{m.filename}</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Linking Intelligence & Recommendations -->
        <div class="sidebar-card">
          <div class="card-header-flex">
            <h2 class="card-title">Interlinking Recommendations</h2>
            <span class="provider-badge">SEO Engine</span>
          </div>

          <div class="linking-sidebar-block">
            {recommendedLinks.length === 0 ? (
              <p class="field-hint">No other published articles found to recommend yet.</p>
            ) : (
              <div class="recommendations-list">
                {recommendedLinks.map((rec) => (
                  <div class="recommendation-item">
                    <div class="rec-info">
                      <div class="rec-title">{rec.title}</div>
                      <div class="rec-meta">
                        <span class="score-badge">Score: {rec.relevanceScore}%</span>
                        {rec.category && <span class="cat-badge">{rec.category}</span>}
                      </div>
                    </div>
                    <button
                      type="button"
                      class="btn btn-outline-xs btn-sidebar-insert"
                      data-slug={rec.slug}
                      data-title={rec.title}
                    >
                      + Insert
                    </button>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>

        <!-- Revision History (Phase 9) -->
        <div class="sidebar-card">
          <h2 class="card-title">Revision History ({revisions.length})</h2>
          {revisions.length === 0 ? (
            <span class="field-hint">No prior snapshots recorded.</span>
          ) : (
            <ul class="revisions-list">
              {revisions.slice(0, 5).map((r) => (
                <li class="revision-item">
                  <div>
                    <span class="rev-type badge badge-neutral">{r.change_type}</span>
                    <span class="rev-date">{new Date(r.created_at).toLocaleDateString()}</span>
                  </div>
                  <span class="rev-user">{r.changed_by_email || 'System / AI'}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </div>
  </form>
</AdminLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .back-link {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
  }

  .editor-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1.5rem;
    align-items: start;
  }

  .editor-main {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .editor-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .editor-card, .sidebar-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .card-title {
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .title-input {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .content-textarea {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
    resize: vertical;
  }

  .markdown-hints {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 0.35rem;
  }

  .field-hint {
    display: block;
    font-size: 0.6875rem;
    color: var(--color-text-dim);
    margin-top: 0.25rem;
  }

  .published-meta {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    padding: 0.5rem 0.75rem;
    background-color: var(--color-surface-subtle);
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .meta-val {
    font-weight: 600;
    color: var(--color-text-main);
  }

  .form-actions-stack {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .btn-block {
    width: 100%;
    text-align: center;
  }

  .tags-checklist {
    max-height: 160px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.5rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .alert {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }

  .card-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .provider-badge {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    color: var(--color-brand-accent);
  }

  .active-image-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .image-preview-container {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: #000;
    aspect-ratio: 16/9;
  }

  .featured-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .version-tag {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    background: rgba(0,0,0,0.75);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-sm);
  }

  .image-meta-info {
    font-size: 0.75rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .meta-lbl {
    color: var(--color-text-muted);
  }

  .meta-val {
    font-weight: 600;
    color: var(--color-text-main);
    font-family: var(--font-mono);
  }

  .alt-text-preview {
    font-family: var(--font-sans);
    font-weight: normal;
    font-style: italic;
    font-size: 0.71875rem;
    text-align: right;
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .image-action-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .image-btn-row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .btn-danger-link {
    color: var(--color-danger);
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    text-decoration: underline;
  }

  .no-image-banner {
    background-color: var(--color-surface-subtle);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1rem;
    text-align: center;
  }

  .empty-img-text {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem 0;
  }

  .generate-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .image-versions-history {
    margin-top: 1rem;
    border-top: 1px solid var(--color-border);
    padding-top: 0.75rem;
  }

  .versions-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin: 0 0 0.5rem 0;
  }

  .versions-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .version-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
