<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const textarea = document.getElementById('content');
    if (!textarea) return;

    document.querySelectorAll('.btn-sidebar-insert').forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.dataset.slug;
        const title = btn.dataset.title;
        if (!slug || !title) return;

        const start = textarea.selectionStart;
        const end = textarea.selectionEnd;
        const selected = textarea.value.substring(start, end);
        const anchor = selected || title;
        const markdown = `[${anchor}](/article/${slug})`;

        textarea.value = textarea.value.substring(0, start) + markdown + textarea.value.substring(end);
        const newPos = start + markdown.length;
        textarea.focus();
        textarea.setSelectionRange(newPos, newPos);
        textarea.dispatchEvent(new Event('input', { bubbles: true }));
      });
    });
  });
</script>
