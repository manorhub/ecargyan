---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getDb } from '../../../../lib/db/client';
import { renderMarkdown } from '../../../../lib/utils/markdown';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/articles', 302);

// Must be authenticated admin
if (!Astro.locals.admin) {
  return Astro.redirect('/admin/login', 302);
}

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);
if (!dbService) return Astro.redirect('/admin/articles', 302);

const article = await dbService.getArticleById(id);
if (!article) return Astro.redirect('/admin/articles', 302);

const contentHtml = renderMarkdown(article.content);
---

<BaseLayout
  seo={{
    title: `[PREVIEW] ${article.title}`,
    description: article.excerpt || article.seo?.meta_description || '',
    noindex: true,
  }}
>
  <div class="preview-banner">
    <div class="container-narrow banner-inner">
      <span class="badge badge-warning">Admin Preview Mode</span>
      <span class="preview-status">Status: <strong>{article.status.toUpperCase()}</strong></span>
      <a href={`/admin/articles/${article.id}/edit`} class="btn btn-secondary btn-xs">&larr; Return to Editor</a>
    </div>
  </div>

  <article class="article-container">
    <div class="container-narrow">
      <header class="article-header">
        {article.category && (
          <span class="article-category-badge">{article.category.name}</span>
        )}
        <h1 class="article-headline">{article.title}</h1>
        {article.excerpt && (
          <p class="article-lead">{article.excerpt}</p>
        )}

        <div class="article-byline">
          {article.author && (
            <span class="byline-author">By <strong>{article.author.name}</strong></span>
          )}
          <span class="byline-date">
            {article.published_at ? new Date(article.published_at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'Unpublished'}
          </span>
        </div>
      </header>

      {article.featured_image && (
        <figure class="featured-media">
          <img src={`/api/media/${article.featured_image.storage_key}`} alt={article.featured_image.alt_text || article.title} />
          {article.featured_image.caption && (
            <figcaption>{article.featured_image.caption}</figcaption>
          )}
        </figure>
      )}

      <div class="article-body prose" set:html={contentHtml} />

      {article.tags && article.tags.length > 0 && (
        <div class="article-tags-wrap">
          <span class="tags-label">Tags:</span>
          <div class="tags-list">
            {article.tags.map((t) => (
              <span class="tag-pill">#{t.name}</span>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .preview-banner {
    background-color: var(--color-surface);
    border-bottom: 2px solid var(--color-warning);
    padding: 0.75rem 0;
    font-size: 0.8125rem;
  }

  .banner-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .preview-status strong {
    color: var(--color-brand);
  }

  .article-container {
    padding: 4rem 0 6rem;
  }

  .article-header {
    margin-bottom: 2.5rem;
    text-align: left;
  }

  .article-category-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brand-accent);
    margin-bottom: 1rem;
  }

  .article-headline {
    font-size: 3rem;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  .article-lead {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    margin-bottom: 1.75rem;
  }

  .article-byline {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .featured-media {
    margin: 2.5rem 0;
  }

  .featured-media img {
    width: 100%;
    border-radius: var(--radius-md);
  }

  .featured-media figcaption {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
    text-align: center;
  }

  .prose {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text-main);
  }

  .prose :global(h2) {
    font-size: 1.75rem;
    margin: 2.5rem 0 1rem;
  }

  .prose :global(h3) {
    font-size: 1.35rem;
    margin: 2rem 0 0.75rem;
  }

  .prose :global(p) {
    margin-bottom: 1.5rem;
  }

  .prose :global(ul), .prose :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.75rem;
  }

  .prose :global(li) {
    margin-bottom: 0.35rem;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-brand);
    padding-left: 1.25rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin: 2rem 0;
  }

  .prose :global(pre) {
    background-color: var(--color-brand);
    color: #ffffff;
    padding: 1.25rem;
    border-radius: var(--radius-sm);
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background-color: var(--color-surface-subtle);
    padding: 0.15rem 0.35rem;
    border-radius: var(--radius-sm);
  }

  .article-tags-wrap {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .tags-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-pill {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-main);
  }

  .btn-xs {
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
  }
</style>
