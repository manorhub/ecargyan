---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/db/client';
import type { ArticleStatus } from '../../../lib/db/schema';

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);

const url = new URL(Astro.request.url);
const statusFilter = (url.searchParams.get('status') || '') as ArticleStatus | '';
const categoryFilter = url.searchParams.get('category') || '';
const authorFilter = url.searchParams.get('author') || '';
const search = url.searchParams.get('q') || '';
const page = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));
const pageSize = 15;
const offset = (page - 1) * pageSize;

let articlesData = { articles: [] as any[], total: 0 };
let categories: any[] = [];
let authors: any[] = [];

if (dbService) {
  [articlesData, categories, authors] = await Promise.all([
    dbService.listArticles({
      status: statusFilter ? statusFilter : undefined,
      categoryId: categoryFilter ? categoryFilter : undefined,
      authorId: authorFilter ? authorFilter : undefined,
      search: search ? search : undefined,
      limit: pageSize,
      offset,
    }),
    dbService.listCategories(),
    dbService.listAuthors(),
  ]);
}

const totalPages = Math.ceil(articlesData.total / pageSize) || 1;

function formatDate(ts: number | null): string {
  if (!ts) return '—';
  return new Date(ts).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
const successMsg = url.searchParams.get('success') || '';
const errorMsg = url.searchParams.get('error') || '';
---

<AdminLayout title="Articles" currentPath="/admin/articles">
  <div class="page-header">
    <div>
      <h1 class="page-title">Articles & Editorial CMS</h1>
      <p class="page-description">
        Author, review, schedule, and publish automotive editorial dispatches.
      </p>
    </div>
    <div>
      <a href="/admin/articles/new" class="btn btn-primary">Create Article</a>
    </div>
  </div>

  {successMsg && <div class="alert alert-success">{successMsg}</div>}
  {errorMsg && <div class="alert alert-danger">{errorMsg}</div>}

  <div class="filter-panel">
    <form method="GET" class="filter-form">
      <div class="filter-group">
        <input
          type="search"
          name="q"
          value={search}
          placeholder="Search articles..."
          class="form-input filter-search"
        />
      </div>

      <div class="filter-group">
        <select name="status" class="form-input filter-select" onchange="this.form.submit()">
          <option value="">All Statuses</option>
          <option value="draft" selected={statusFilter === 'draft'}>Draft</option>
          <option value="review" selected={statusFilter === 'review'}>In Review</option>
          <option value="scheduled" selected={statusFilter === 'scheduled'}>Scheduled</option>
          <option value="published" selected={statusFilter === 'published'}>Published</option>
          <option value="archived" selected={statusFilter === 'archived'}>Archived</option>
        </select>
      </div>

      <div class="filter-group">
        <select name="category" class="form-input filter-select" onchange="this.form.submit()">
          <option value="">All Categories</option>
          {categories.map((c) => (
            <option value={c.id} selected={categoryFilter === c.id}>{c.name}</option>
          ))}
        </select>
      </div>

      <div class="filter-group">
        <select name="author" class="form-input filter-select" onchange="this.form.submit()">
          <option value="">All Authors</option>
          {authors.map((a) => (
            <option value={a.id} selected={authorFilter === a.id}>{a.name}</option>
          ))}
        </select>
      </div>

      <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
      {(statusFilter || categoryFilter || authorFilter || search) && (
        <a href="/admin/articles" class="btn btn-secondary btn-sm">Reset</a>
      )}
    </form>
  </div>

  <div class="table-card">
    <div class="card-header">
      <h2 class="card-title">Editorial Pipeline ({articlesData.total} Articles)</h2>
    </div>

    {articlesData.articles.length === 0 ? (
      <div class="empty-box">
        <p class="empty-text">No articles yet.</p>
        <span class="empty-subtext">The editorial pipeline is empty. Create your first article to begin publishing.</span>
        <div class="empty-action">
          <a href="/admin/articles/new" class="btn btn-secondary">Create First Article</a>
        </div>
      </div>
    ) : (
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Status</th>
              <th>Category</th>
              <th>Author</th>
              <th>Published</th>
              <th>Updated</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            {articlesData.articles.map((art) => (
              <tr>
                <td class="title-cell">
                  <a href={`/admin/articles/${art.id}/edit`} class="article-title-link">
                    {art.title}
                  </a>
                  <span class="article-slug">/{art.slug}</span>
                </td>
                <td>
                  <span class:list={[
                    'badge',
                    art.status === 'published' ? 'badge-success' :
                    art.status === 'scheduled' ? 'badge-warning' : 'badge-neutral'
                  ]}>
                    {art.status}
                  </span>
                </td>
                <td>
                  {art.category ? (
                    <span class="category-tag">{art.category.name}</span>
                  ) : (
                    <span class="text-muted">—</span>
                  )}
                </td>
                <td>
                  {art.author ? (
                    <span class="author-name">{art.author.name}</span>
                  ) : (
                    <span class="text-muted">—</span>
                  )}
                </td>
                <td><span class="date-text">{formatDate(art.published_at)}</span></td>
                <td><span class="date-text">{formatDate(art.updated_at)}</span></td>
                <td class="text-right">
                  <div class="actions-group">
                    {art.status !== 'published' && (
                      <form action={`/admin/articles/${art.id}/publish`} method="POST" style="display:inline;" onsubmit="return confirm('Publish this article live to the website immediately?');">
                        <button type="submit" class="btn btn-primary btn-xs" style="background-color: #16a34a; border-color: #15803d;">
                          ⚡ Publish
                        </button>
                      </form>
                    )}
                    <a href={`/admin/articles/${art.id}/preview`} class="btn btn-secondary btn-xs">
                      Preview
                    </a>
                    <a href={`/admin/articles/${art.id}/edit`} class="btn btn-secondary btn-xs">
                      Edit
                    </a>
                    <form action="/admin/articles/delete" method="POST" onsubmit="return confirm('Permanently delete this article?');">
                      <input type="hidden" name="id" value={art.id} />
                      <button type="submit" class="btn btn-danger btn-xs">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {totalPages > 1 && (
      <div class="pagination">
        {page > 1 && (
          <a href={`?page=${page - 1}&status=${statusFilter}&category=${categoryFilter}&author=${authorFilter}&q=${search}`} class="btn btn-secondary btn-sm">
            &larr; Previous
          </a>
        )}
        <span class="page-info">Page {page} of {totalPages}</span>
        {page < totalPages && (
          <a href={`?page=${page + 1}&status=${statusFilter}&category=${categoryFilter}&author=${authorFilter}&q=${search}`} class="btn btn-secondary btn-sm">
            Next &rarr;
          </a>
        )}
      </div>
    )}
  </div>
</AdminLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .page-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .filter-panel {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
  }

  .filter-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .filter-search {
    min-width: 220px;
  }

  .filter-select {
    width: auto;
    min-width: 140px;
    font-size: 0.8125rem;
    padding: 0.5rem 0.75rem;
  }

  .table-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .card-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .title-cell {
    max-width: 320px;
  }

  .article-title-link {
    font-weight: 600;
    color: var(--color-text-main);
    display: block;
    line-height: 1.3;
  }

  .article-title-link:hover {
    color: var(--color-accent-blue);
  }

  .article-slug {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-dim);
    display: block;
    margin-top: 0.15rem;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .admin-table th {
    text-align: left;
    padding: 0.75rem 1.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    background-color: var(--color-surface-subtle);
    border-bottom: 1px solid var(--color-border);
  }

  .admin-table td {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  .date-text {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .text-muted {
    color: var(--color-text-dim);
  }

  .text-right {
    text-align: right;
  }

  .actions-group {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }

  .btn-sm {
    padding: 0.35rem 0.75rem;
    font-size: 0.8125rem;
  }

  .btn-xs {
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
  }

  .empty-box {
    padding: 4rem 2rem;
    text-align: center;
  }

  .empty-text {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .empty-subtext {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .empty-action {
    margin-top: 1.5rem;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .page-info {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .page-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .filter-form {
      flex-direction: column;
      align-items: stretch;
    }

    .filter-search, .filter-select {
      width: 100%;
      min-width: 0;
    }

    .admin-table th, .admin-table td {
      padding: 0.75rem 0.875rem;
    }
  }
</style>
