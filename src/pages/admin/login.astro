---
import { getDb } from '../../lib/db/client';
import { verifyPassword } from '../../lib/auth/password';
import { createSessionToken } from '../../lib/auth/session';
import '../../styles/global.css';

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);

// If already authenticated, redirect to /admin
if (Astro.locals.admin) {
  return Astro.redirect('/admin', 302);
}

let errorMessage = '';
const url = new URL(Astro.request.url);
const targetRedirect = url.searchParams.get('redirect') || '/admin';

if (dbService) {
  const adminCount = await dbService.getAdminCount();
  // If no admin accounts exist yet, guide to setup
  if (adminCount === 0) {
    return Astro.redirect('/admin/setup', 302);
  }
}

if (Astro.request.method === 'POST' && dbService) {
  try {
    const formData = await Astro.request.formData();
    const email = (formData.get('email') as string || '').trim().toLowerCase();
    const password = (formData.get('password') as string || '').trim();

    if (!email || !password) {
      errorMessage = 'Please provide both email and password.';
    } else {
      const admin = await dbService.getAdminByEmail(email);
      if (!admin) {
        errorMessage = 'Invalid email or password.';
      } else {
        const isValid = await verifyPassword(password, admin.password_hash, admin.password_salt);
        if (!isValid) {
          errorMessage = 'Invalid email or password.';
        } else {
          // Update last login
          await dbService.updateAdminLastLogin(admin.id);

          // Create session
          const token = await createSessionToken(
            { adminId: admin.id, email: admin.email, role: admin.role },
            runtimeEnv?.SESSION_SECRET
          );

          const isProd = runtimeEnv?.ENVIRONMENT === 'production';
          Astro.cookies.set('ec_admin_session', token, {
            path: '/',
            maxAge: 60 * 60 * 24 * 7,
            httpOnly: true,
            secure: isProd,
            sameSite: 'lax',
          });

          return Astro.redirect((formData.get('redirect') as string || '/admin').trim(), 302);
        }
      }
    }
  } catch {
    errorMessage = 'Authentication service error. Please try again.';
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Editorial Login — ECargyan</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="login-body">
    <div class="login-container">
      <div class="login-card">
        <div class="login-header">
          <a href="/" class="brand-link">
            <span class="brand-title">ECargyan</span>
          </a>
          <h1 class="login-heading">Editorial Sign In</h1>
          <p class="login-subhead">Authorized publishing personnel only.</p>
        </div>

        {errorMessage && (
          <div class="alert alert-danger" role="alert">
            {errorMessage}
          </div>
        )}

        <form method="POST" class="login-form">
          <input type="hidden" name="redirect" value={targetRedirect} />

          <div class="form-group">
            <label for="email" class="form-label">Email Address</label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-input"
              required
              autocomplete="username"
            />
          </div>

          <div class="form-group">
            <label for="password" class="form-label">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              class="form-input"
              required
              autocomplete="current-password"
            />
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            Authenticate
          </button>
        </form>

        <div class="login-footer">
          <a href="/" class="back-link">&larr; Return to ECargyan Public Site</a>
        </div>
      </div>
    </div>
  </body>
</html>

<style>
  .login-body {
    background-color: var(--color-surface-subtle);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
  }

  .login-container {
    width: 100%;
    max-width: 400px;
  }

  .login-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  .login-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .brand-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-brand);
    display: block;
    margin-bottom: 1rem;
  }

  .login-heading {
    font-size: 1.375rem;
    margin-bottom: 0.25rem;
  }

  .login-subhead {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .alert {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
  }

  .alert-danger {
    background-color: var(--color-danger-bg);
    color: var(--color-danger);
    border: 1px solid #fecaca;
  }

  .btn-block {
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.75rem;
  }

  .login-footer {
    margin-top: 1.75rem;
    text-align: center;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .back-link:hover {
    color: var(--color-text-main);
  }
</style>
