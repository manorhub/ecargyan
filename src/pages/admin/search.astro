---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db/client';
import { AdminSearchService } from '../../lib/admin/search';

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);
if (!dbService) return Astro.redirect('/admin', 302);

const url = new URL(Astro.request.url);
const query = (url.searchParams.get('q') || '').trim();

let results = {
  query,
  articles: [] as any[],
  sources: [] as any[],
  research: [] as any[],
  jobs: [] as any[],
};

if (query && runtimeEnv?.DB) {
  const searchService = new AdminSearchService(runtimeEnv.DB);
  results = await searchService.search(query);
}

const totalMatches =
  results.articles.length +
  results.sources.length +
  results.research.length +
  results.jobs.length;
---

<AdminLayout title={query ? `Search: "${query}"` : 'Global Admin Search'} currentPath="/admin">
  <div class="page-header">
    <div>
      <h1 class="page-title">Global Admin Search</h1>
      <p class="page-description">Search across articles, RSS sources, research intelligence, and automation jobs.</p>
    </div>
  </div>

  <div class="search-box-card">
    <form action="/admin/search" method="GET" class="search-form">
      <input
        type="search"
        name="q"
        value={query}
        placeholder="Enter keyword, slug, source name, or job ID..."
        class="form-input search-input"
        autofocus
      />
      <button type="submit" class="btn btn-primary">Search</button>
    </form>
  </div>

  {query && (
    <div class="search-results-summary">
      Found <strong>{totalMatches}</strong> matching records for <em>"{query}"</em>
    </div>
  )}

  {query && totalMatches === 0 && (
    <div class="empty-box">
      <p class="empty-text">No matching records found.</p>
      <span class="empty-subtext">Try searching for a different keyword, slug, or identifier.</span>
    </div>
  )}

  <div class="results-grid">
    <!-- Articles Matches -->
    {results.articles.length > 0 && (
      <div class="card">
        <h2 class="card-title">Articles ({results.articles.length})</h2>
        <ul class="results-list">
          {results.articles.map((art) => (
            <li class="result-item">
              <div>
                <a href={`/admin/articles/${art.id}/edit`} class="result-title-link">
                  {art.title}
                </a>
                <span class="result-meta">/article/{art.slug}</span>
              </div>
              <span class:list={[
                'badge',
                art.status === 'published' ? 'badge-success' :
                art.status === 'review' ? 'badge-warning' : 'badge-neutral'
              ]}>
                {art.status.toUpperCase()}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Sources Matches -->
    {results.sources.length > 0 && (
      <div class="card">
        <h2 class="card-title">Sources ({results.sources.length})</h2>
        <ul class="results-list">
          {results.sources.map((s) => (
            <li class="result-item">
              <div>
                <a href={`/admin/sources/${s.id}`} class="result-title-link">
                  {s.name}
                </a>
                <span class="result-meta">{s.baseUrl}</span>
              </div>
              <span class:list={['badge', s.status === 'active' ? 'badge-success' : 'badge-neutral']}>
                {s.status.toUpperCase()}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Research Matches -->
    {results.research.length > 0 && (
      <div class="card">
        <h2 class="card-title">Research Records ({results.research.length})</h2>
        <ul class="results-list">
          {results.research.map((r) => (
            <li class="result-item">
              <div>
                <a href={`/admin/research/${r.id}`} class="result-title-link">
                  {r.title}
                </a>
                <span class="result-meta">{r.sourceCount} sources</span>
              </div>
              <span class:list={['badge', r.status === 'ready' ? 'badge-success' : 'badge-neutral']}>
                {r.status.toUpperCase()}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Automation Jobs Matches -->
    {results.jobs.length > 0 && (
      <div class="card">
        <h2 class="card-title">Automation Jobs ({results.jobs.length})</h2>
        <ul class="results-list">
          {results.jobs.map((j) => (
            <li class="result-item">
              <div>
                <a href={`/admin/automation/jobs/${j.id}`} class="result-title-link mono">
                  {j.id}
                </a>
                <span class="result-meta">{j.jobType}</span>
              </div>
              <span class:list={[
                'badge',
                j.status === 'completed' ? 'badge-success' :
                j.status === 'failed' ? 'badge-danger' : 'badge-neutral'
              ]}>
                {j.status.toUpperCase()}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</AdminLayout>

<style>
  .page-header {
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .page-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .search-box-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .search-form {
    display: flex;
    gap: 0.75rem;
  }

  .search-input {
    flex: 1;
    font-size: 0.9375rem;
    padding: 0.6rem 1rem;
  }

  .search-results-summary {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .results-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .card-title {
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .results-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .result-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.75rem;
    background-color: var(--color-surface-subtle);
    border-radius: var(--radius-sm);
  }

  .result-title-link {
    font-weight: 600;
    color: var(--color-text-main);
    display: block;
    font-size: 0.8125rem;
  }

  .result-title-link:hover {
    color: var(--color-accent-blue);
  }

  .result-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-dim);
    display: block;
  }

  .mono {
    font-family: var(--font-mono);
  }

  .empty-box {
    padding: 4rem 2rem;
    text-align: center;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .empty-text {
    font-size: 1rem;
    font-weight: 600;
  }

  .empty-subtext {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .results-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
