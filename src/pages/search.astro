---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ui/ArticleCard.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Pagination from '../components/ui/Pagination.astro';
import { getDb } from '../lib/db/client';
import { getCanonicalUrl } from '../lib/config/site';

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);

const url = new URL(Astro.request.url);
const query = (url.searchParams.get('q') || '').trim();
const page = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));
const pageSize = 9;
const offset = (page - 1) * pageSize;

let searchResults: any[] = [];
let totalResults = 0;

if (query && dbService) {
  const result = await dbService.getPublishedArticles({
    search: query,
    limit: pageSize,
    offset,
  });
  searchResults = result.articles;
  totalResults = result.total;
}

const totalPages = Math.ceil(totalResults / pageSize) || 1;
const canonicalUrl = getCanonicalUrl('/search');
---

<BaseLayout
  seo={{
    title: query ? `Search: ${query}` : 'Search Dispatches',
    description: 'Search ECargyan automotive reports, vehicle architecture analyses, and technical intelligence.',
    canonicalUrl,
    noindex: true,
  }}
  currentPath="/search"
>
  <section class="search-masthead">
    <div class="container search-hero-inner">
      <span class="search-kicker">Archive Search</span>
      <h1 class="search-title">Search Intelligence</h1>
      <form method="GET" action="/search" class="search-form-wrap">
        <div class="search-input-group">
          <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            name="q"
            value={query}
            placeholder="Search vehicle models, battery specs, powertrain architectures..."
            class="search-text-input"
            required
            autofocus
          />
          <button type="submit" class="btn btn-primary search-submit-btn">Search</button>
        </div>
      </form>
    </div>
  </section>

  <main class="container search-main-container">
    {query ? (
      <>
        <div class="search-results-bar">
          <span class="search-meta-text">
            {totalResults} {totalResults === 1 ? 'Dispatch Found' : 'Dispatches Found'} for <strong>&ldquo;{query}&rdquo;</strong>
          </span>
        </div>

        {totalResults === 0 ? (
          <EmptyState
            title={`No dispatches found matching “${query}”.`}
            message="Try searching for broader keywords such as 'battery', 'charging', 'motor', or vehicle brand names."
            actionText="Browse All Dispatches"
            actionHref="/"
          />
        ) : (
          <>
            <div class="articles-grid-3col">
              {searchResults.map((art) => (
                <ArticleCard article={art} variant="standard" />
              ))}
            </div>

            {totalPages > 1 && (
              <div class="pagination-wrap">
                <Pagination
                  currentPage={page}
                  totalPages={totalPages}
                  baseUrl={`/search?q=${encodeURIComponent(query)}`}
                />
              </div>
            )}
          </>
        )}
      </>
    ) : (
      <div class="search-placeholder-box">
        <p class="placeholder-text">Enter technical topics, battery chemistry queries, or brand names above to explore the archive.</p>
      </div>
    )}
  </main>
</BaseLayout>

<style>
  .search-masthead {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(2rem, 4vw, 3rem);
  }

  .search-hero-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .search-kicker {
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-electric-accent);
    display: block;
    margin-bottom: 0.5rem;
  }

  .search-title {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    color: var(--color-brand);
    margin-bottom: 1.5rem;
  }

  .search-form-wrap {
    width: 100%;
  }

  .search-input-group {
    display: flex;
    align-items: center;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.5rem 0.35rem 1rem;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .search-input-group:focus-within {
    border-color: var(--color-electric-accent);
    box-shadow: 0 0 0 1px var(--color-electric-accent);
  }

  .search-icon {
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin-right: 0.5rem;
  }

  .search-text-input {
    flex-grow: 1;
    border: none;
    background: transparent;
    padding: 0.5rem 0.25rem;
    font-size: 1rem;
    color: var(--color-text-main);
  }

  .search-text-input:focus {
    outline: none;
  }

  .search-submit-btn {
    padding: 0.5rem 1.25rem;
  }

  .search-main-container {
    padding: clamp(2.5rem, 5vw, 4rem) 1.5rem clamp(3rem, 6vw, 6rem);
  }

  .search-results-bar {
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .search-meta-text {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .articles-grid-3col {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .pagination-wrap {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
  }

  .search-placeholder-box {
    text-align: center;
    padding: 4rem 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  @media (max-width: 640px) {
    .articles-grid-3col {
      grid-template-columns: 1fr;
    }
  }
</style>
