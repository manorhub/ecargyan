---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import ArticleCard from '../../components/ui/ArticleCard.astro';
import JsonLd from '../../components/ui/JsonLd.astro';
import { getDb } from '../../lib/db/client';
import { renderMarkdown } from '../../lib/utils/markdown';
import { calculateReadingTime } from '../../lib/utils/reading-time';
import { formatDate } from '../../lib/utils/formatters';
import { generateArticleJsonLd, generateBreadcrumbJsonLd } from '../../lib/utils/json-ld';
import { getCanonicalUrl } from '../../lib/config/site';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404', 302);

const runtimeEnv = Astro.locals.runtime?.env;
const dbService = getDb(runtimeEnv);
if (!dbService) return Astro.redirect('/500', 302);

const article = await dbService.getArticleBySlug(slug);
if (!article) return Astro.redirect('/404', 302);

// Access Control: published articles only unless logged in as admin
const isPubliclyAvailable = article.status === 'published' && article.published_at && article.published_at <= Date.now();
const isAdmin = Boolean(Astro.locals.admin);

if (!isPubliclyAvailable && !isAdmin) {
  return Astro.redirect('/404', 302);
}

const contentHtml = renderMarkdown(article.content);
const readingTime = calculateReadingTime(article.content);
const formattedPubDate = formatDate(article.published_at, 'long');
const formattedModDate = formatDate(article.updated_at, 'long');

const relatedArticles = await dbService.getRelatedArticles(article.id, article.category_id, 3);

const canonicalUrl = article.seo?.canonical_url || getCanonicalUrl(`/article/${article.slug}`);
const seoTitle = article.seo?.meta_title || article.title;
const seoDesc = article.seo?.meta_description || article.excerpt || undefined;
const ogImage = article.featured_image ? `/api/media/${article.featured_image.storage_key}` : undefined;

const breadcrumbItems = [];
if (article.category) {
  breadcrumbItems.push({ name: article.category.name, url: `/category/${article.category.slug}` });
}
breadcrumbItems.push({ name: article.title, url: `/article/${article.slug}` });

const articleSchema = generateArticleJsonLd({
  title: article.title,
  description: article.excerpt || article.seo?.meta_description || undefined,
  url: canonicalUrl,
  image: ogImage ? getCanonicalUrl(ogImage) : undefined,
  publishedTime: article.published_at ? new Date(article.published_at).toISOString() : undefined,
  modifiedTime: new Date(article.updated_at).toISOString(),
  authorName: article.author?.name || undefined,
});

const breadcrumbSchema = generateBreadcrumbJsonLd(breadcrumbItems);
---

<BaseLayout
  seo={{
    title: seoTitle,
    description: seoDesc,
    canonicalUrl,
    ogImage,
    ogType: 'article',
    author: article.author?.name || undefined,
    publishedTime: article.published_at ? new Date(article.published_at).toISOString() : undefined,
    modifiedTime: new Date(article.updated_at).toISOString(),
  }}
  currentPath={`/article/${article.slug}`}
>
  <JsonLd schema={[articleSchema, breadcrumbSchema]} />

  {!isPubliclyAvailable && isAdmin && (
    <div class="draft-notice">
      <div class="container-narrow notice-inner">
        <span class="badge badge-warning">Admin Preview</span>
        <span>Article Status: <strong>{article.status.toUpperCase()}</strong>. Visible only to logged in administrators.</span>
        <a href={`/admin/articles/${article.id}/edit`} class="btn btn-secondary btn-xs">Edit Article</a>
      </div>
    </div>
  )}

  <article class="article-page-wrapper">
    <!-- Masthead & Article Header -->
    <header class="article-masthead">
      <div class="container-narrow">
        <Breadcrumbs items={breadcrumbItems} />

        <div class="header-inner">
          {article.category && (
            <div class="category-wrapper">
              <a href={`/category/${article.category.slug}`} class="category-kicker">
                {article.category.name}
              </a>
            </div>
          )}

          <h1 class="article-headline">{article.title}</h1>

          {article.excerpt && (
            <p class="article-deck">{article.excerpt}</p>
          )}

          <!-- Rich Byline Bar -->
          <div class="byline-bar">
            <div class="byline-left">
              {article.author ? (
                <div class="author-info">
                  <span class="byline-label">Reporting by</span>
                  <a href={`/author/${article.author.slug}`} class="author-name">
                    {article.author.name}
                  </a>
                </div>
              ) : (
                <div class="author-info">
                  <span class="byline-label">Dispatch from</span>
                  <span class="author-name">ECargyan Editorial Staff</span>
                </div>
              )}
            </div>

            <div class="byline-right">
              {formattedPubDate && (
                <div class="date-item">
                  <span class="byline-label">Published</span>
                  <time datetime={new Date(article.published_at || 0).toISOString()}>{formattedPubDate}</time>
                </div>
              )}
              {article.updated_at && article.published_at && (article.updated_at - article.published_at > 3600000) && (
                <div class="date-item updated-item">
                  <span class="byline-label">Updated</span>
                  <time datetime={new Date(article.updated_at).toISOString()}>{formattedModDate}</time>
                </div>
              )}
              <div class="read-item">
                <span class="byline-label">Read Time</span>
                <span class="read-time">{readingTime}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Full-Width / Large Featured Hero Image -->
    {article.featured_image ? (
      <div class="container hero-media-container">
        <figure class="hero-figure">
          <img
            src={`/api/media/${article.featured_image.storage_key}`}
            alt={article.featured_image.alt_text || article.title}
            class="hero-img"
            loading="eager"
            fetchpriority="high"
          />
          {article.featured_image.caption && (
            <figcaption class="hero-caption">
              {article.featured_image.caption}
            </figcaption>
          )}
        </figure>
      </div>
    ) : (
      <div class="container-narrow hero-divider-wrap">
        <hr class="hero-divider" />
      </div>
    )}

    <!-- Editorial Article Body (~720px optimal reading column) -->
    <div class="container-narrow article-body-container">
      <div class="article-prose" set:html={contentHtml} />

      <!-- Article Tags -->
      {article.tags && article.tags.length > 0 && (
        <div class="article-tags-wrap">
          <span class="tags-label">Classifications:</span>
          <div class="tags-list">
            {article.tags.map((tag) => (
              <span class="tag-chip">#{tag.name}</span>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Related Editorial Dispatches -->
    {relatedArticles.length > 0 && (
      <section class="related-dispatches-section">
        <div class="container">
          <div class="section-header">
            <h2 class="section-title">Related Dispatches</h2>
            {article.category && (
              <a href={`/category/${article.category.slug}`} class="section-link">
                More in {article.category.name} &rarr;
              </a>
            )}
          </div>

          <div class="related-grid">
            {relatedArticles.map((relArt) => (
              <ArticleCard article={relArt} variant="standard" />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .draft-notice {
    background-color: #fffbeb;
    border-bottom: 1px solid #fde68a;
    padding: 0.65rem 0;
    font-size: 0.8125rem;
  }

  .notice-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .btn-xs {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
  }

  /* Article Masthead */
  .article-masthead {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: clamp(2rem, 4vw, 3.5rem) 0 clamp(1.5rem, 3vw, 2.5rem);
  }

  .category-wrapper {
    margin-bottom: 0.75rem;
  }

  .article-headline {
    font-size: clamp(2rem, 4.8vw, 3.25rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: var(--color-brand);
    margin-bottom: 1rem;
  }

  .article-deck {
    font-size: clamp(1.0625rem, 2.2vw, 1.25rem);
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin-bottom: 1.75rem;
  }

  .byline-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .byline-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .byline-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    display: block;
  }

  .author-name {
    font-weight: 700;
    color: var(--color-text-main);
  }

  .author-name:hover {
    color: var(--color-electric-accent);
  }

  .byline-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .date-item, .read-item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .date-item time, .read-time {
    font-weight: 600;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }

  /* Hero Media Container */
  .hero-media-container {
    max-width: 1080px;
    margin: clamp(2rem, 4vw, 3rem) auto;
  }

  .hero-figure {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--color-brand);
    box-shadow: var(--shadow-sm);
  }

  .hero-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .hero-caption {
    padding: 0.65rem 1rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .hero-divider-wrap {
    margin: 2rem auto;
  }

  .hero-divider {
    border: none;
    border-top: 1px solid var(--color-border);
  }

  /* Article Reading Body */
  .article-body-container {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .article-tags-wrap {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .tags-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .tags-list {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag-chip {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-xs);
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  /* Related Dispatches Section */
  .related-dispatches-section {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: clamp(3rem, 5vw, 4.5rem) 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  @media (max-width: 768px) {
    .byline-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .byline-right {
      gap: 1rem;
      flex-wrap: wrap;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
