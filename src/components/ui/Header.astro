---
import { getDb } from '../../lib/db/client';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const dbService = getDb(Astro.locals.runtime?.env);
let categories: any[] = [];

if (dbService) {
  categories = await dbService.getActiveCategoriesWithCounts();
}
---

<header class="site-header">
  <!-- Masthead Top Utility & Brand Bar -->
  <div class="masthead-top">
    <div class="container masthead-inner">
      <div class="masthead-left">
        <time datetime={new Date().toISOString()} class="masthead-date">
          {new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })}
        </time>
        <span class="masthead-divider" aria-hidden="true">|</span>
        <span class="masthead-edition">EV Intelligence</span>
      </div>

      <div class="brand-center">
        <a href="/" class="brand-link" aria-label="ECargyan Home">
          <span class="brand-name">ECARGYAN<span class="brand-dot">.</span></span>
        </a>
      </div>

      <div class="masthead-right">
        <a href="/search" class="search-trigger-btn" aria-label="Search dispatches">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="search-text">Search</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Primary Editorial Category Nav (Sticky & Touch-Scrollable) -->
  <nav class="primary-nav" aria-label="Editorial Categories">
    <div class="container nav-container">
      <ul class="nav-links">
        <li>
          <a href="/" class:list={['nav-item', { active: currentPath === '/' }]}>
            Latest
          </a>
        </li>
        {categories.map((cat) => (
          <li>
            <a
              href={`/category/${cat.slug}`}
              class:list={['nav-item', { active: currentPath === `/category/${cat.slug}` }]}
            >
              {cat.name}
            </a>
          </li>
        ))}
        <li>
          <a href="/calculators" class:list={['nav-item', { active: currentPath.startsWith('/calculators') }]}>
            Calculators
          </a>
        </li>
        <li>
          <a href="/about" class:list={['nav-item', { active: currentPath === '/about' }]}>
            About
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-header {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: var(--shadow-sm);
  }

  .masthead-top {
    padding: 1.15rem 0 0.85rem;
    border-bottom: 1px solid var(--color-border-subtle);
    background-color: var(--color-surface);
  }

  .masthead-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .masthead-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .masthead-date {
    font-family: var(--font-mono);
  }

  .masthead-divider {
    color: var(--color-border-dark);
  }

  .masthead-edition {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--color-text-secondary);
    font-size: 0.6875rem;
  }

  .brand-center {
    text-align: center;
  }

  .brand-link {
    display: inline-block;
    color: var(--color-brand);
    transition: transform 0.15s ease;
  }

  .brand-link:hover {
    color: var(--color-brand);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3.5vw, 1.85rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-brand);
  }

  .brand-dot {
    color: var(--color-electric-accent);
  }

  .masthead-right {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .search-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    transition: all 0.15s ease;
  }

  .search-trigger-btn:hover {
    color: var(--color-brand);
    border-color: var(--color-border-dark);
    background-color: #ffffff;
  }

  /* Primary Category Nav */
  .primary-nav {
    background-color: var(--color-surface);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .primary-nav::-webkit-scrollbar {
    display: none;
  }

  .nav-container {
    padding-top: 0;
    padding-bottom: 0;
  }

  .nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
    padding: 0.25rem 0;
  }

  .nav-item {
    display: inline-block;
    padding: 0.5rem 0.85rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    border-radius: var(--radius-xs);
    position: relative;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav-item:hover {
    color: var(--color-brand);
    background-color: var(--color-surface-subtle);
  }

  .nav-item.active {
    color: var(--color-brand);
    font-weight: 700;
    background-color: var(--color-surface-subtle);
  }

  .nav-item.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0.85rem;
    right: 0.85rem;
    height: 2px;
    background-color: var(--color-brand);
    border-radius: 1px;
  }

  /* Mobile Adjustments */
  @media (max-width: 768px) {
    .masthead-top {
      padding: 0.75rem 0;
    }

    .masthead-inner {
      grid-template-columns: auto 1fr auto;
      gap: 0.5rem;
    }

    .masthead-edition, .masthead-divider {
      display: none;
    }

    .masthead-date {
      font-size: 0.6875rem;
    }

    .search-text {
      display: none;
    }

    .search-trigger-btn {
      padding: 0.4rem;
      border-radius: var(--radius-sm);
    }

    .nav-links {
      gap: 0;
    }

    .nav-item {
      padding: 0.45rem 0.65rem;
      font-size: 0.75rem;
    }
  }
</style>
