---
import { SITE_CONFIG } from '../../lib/config/site';
import { getDb } from '../../lib/db/client';

const currentYear = new Date().getFullYear();
const dbService = getDb(Astro.locals.runtime?.env);
let categories: any[] = [];

if (dbService) {
  categories = await dbService.getActiveCategoriesWithCounts();
}
---

<footer class="site-footer">
  <div class="container footer-grid">
    <!-- Brand Info -->
    <div class="footer-col brand-col">
      <a href="/" class="footer-brand">
        {SITE_CONFIG.name}<span class="brand-dot">.</span>
      </a>
      <p class="footer-bio">
        Authoritative editorial analysis, electric vehicle architecture benchmarks, battery technology intelligence, and policy reporting.
      </p>
      <div class="footer-badge-line">
        <span class="status-indicator"></span>
        <span class="status-text">Independent EV Journalism</span>
      </div>
    </div>

    <!-- Categories Directory -->
    {categories.length > 0 && (
      <div class="footer-col">
        <h4 class="col-title">Taxonomy</h4>
        <ul class="col-links">
          {categories.slice(0, 6).map((c) => (
            <li>
              <a href={`/category/${c.slug}`}>{c.name}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Publication Info -->
    <div class="footer-col">
      <h4 class="col-title">Publication</h4>
      <ul class="col-links">
        <li><a href="/about">About ECargyan</a></li>
        <li><a href="/contact">Editorial Desk</a></li>
        <li><a href="/search">Search Archive</a></li>
      </ul>
    </div>

    <!-- Governance -->
    <div class="footer-col">
      <h4 class="col-title">Standards</h4>
      <ul class="col-links">
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms of Publication</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p class="copyright">
      &copy; {currentYear} {SITE_CONFIG.name}. Electric Vehicle Editorial Network. All rights reserved.
    </p>
    <div class="footer-bottom-links">
      <a href="/about">About</a>
      <span aria-hidden="true">&bull;</span>
      <a href="/privacy">Privacy</a>
      <span aria-hidden="true">&bull;</span>
      <a href="/terms">Terms</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
    padding: clamp(3rem, 6vw, 4.5rem) 0 2rem;
    font-size: 0.8125rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-brand {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-brand);
  }

  .brand-dot {
    color: var(--color-electric-accent);
  }

  .footer-bio {
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 360px;
    font-size: 0.875rem;
  }

  .footer-badge-line {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    background-color: var(--color-electric-green);
    border-radius: 50%;
  }

  .col-title {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-main);
    margin-bottom: 1rem;
  }

  .col-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .col-links a {
    color: var(--color-text-secondary);
    transition: color 0.15s ease;
  }

  .col-links a:hover {
    color: var(--color-electric-accent);
  }

  .footer-bottom {
    padding-top: 1.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-bottom-links a:hover {
    color: var(--color-text-main);
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .brand-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .brand-col {
      grid-column: span 1;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
