---
import type { ArticleWithRelations } from '../../lib/db/schema';
import { formatDate } from '../../lib/utils/formatters';
import { calculateReadingTime } from '../../lib/utils/reading-time';

interface Props {
  article: ArticleWithRelations;
  variant?: 'hero' | 'standard' | 'compact' | 'horizontal';
  priorityImage?: boolean;
}

const { article, variant = 'standard', priorityImage = false } = Astro.props;
const readingTime = calculateReadingTime(article.content);
const formattedDate = formatDate(article.published_at);
---

<article class:list={['article-card', `variant-${variant}`]}>
  {article.featured_image && (
    <div class="card-media-wrapper">
      <a href={`/article/${article.slug}`} tabindex="-1" aria-hidden="true" class="card-media-link">
        <img
          src={`/api/media/${article.featured_image.storage_key}`}
          alt={article.featured_image.alt_text || article.title}
          class="card-img"
          loading={priorityImage ? 'eager' : 'lazy'}
          fetchpriority={priorityImage ? 'high' : 'auto'}
        />
      </a>
    </div>
  )}

  <div class="card-content">
    <div class="card-meta-top">
      {article.category && (
        <a href={`/category/${article.category.slug}`} class="card-category">
          {article.category.name}
        </a>
      )}
      <span class="meta-dot" aria-hidden="true">&bull;</span>
      <span class="reading-time">{readingTime}</span>
    </div>

    <h3 class="card-title">
      <a href={`/article/${article.slug}`}>
        {article.title}
      </a>
    </h3>

    {article.excerpt && (
      <p class="card-excerpt">
        {article.excerpt}
      </p>
    )}

    <div class="card-byline">
      {article.author && (
        <span class="byline-author">
          By <a href={`/author/${article.author.slug}`}>{article.author.name}</a>
        </span>
      )}
      {formattedDate && (
        <time datetime={new Date(article.published_at || 0).toISOString()} class="byline-date">
          {formattedDate}
        </time>
      )}
    </div>
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .article-card:hover {
    border-color: var(--color-border-dark);
    box-shadow: var(--shadow-sm);
  }

  .card-media-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-surface-subtle);
    overflow: hidden;
  }

  .card-media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .article-card:hover .card-img {
    transform: scale(1.02);
  }

  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .card-category {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-brand-accent);
  }

  .card-category:hover {
    text-decoration: underline;
  }

  .meta-dot {
    color: var(--color-text-dim);
  }

  .reading-time {
    color: var(--color-text-muted);
  }

  .card-title {
    font-size: clamp(1.15rem, 3vw, 1.35rem);
    line-height: 1.25;
    margin-bottom: 0.75rem;
    letter-spacing: -0.015em;
  }

  .card-title a {
    color: var(--color-text-main);
  }

  .card-title a:hover {
    color: var(--color-brand-accent);
  }

  .card-excerpt {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .card-byline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--color-text-dim);
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .byline-author a {
    color: var(--color-text-main);
    font-weight: 500;
  }

  .byline-author a:hover {
    text-decoration: underline;
  }

  .byline-date {
    color: var(--color-text-muted);
  }

  /* Hero Variant */
  .variant-hero {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
  }

  .variant-hero .card-media-wrapper {
    aspect-ratio: auto;
    height: 100%;
    min-height: 320px;
  }

  .variant-hero .card-content {
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }

  .variant-hero .card-title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .variant-hero .card-excerpt {
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    margin-bottom: 1.5rem;
  }

  /* Compact / Horizontal Variant */
  .variant-compact, .variant-horizontal {
    border: none;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    background: transparent;
    padding: 1.25rem 0;
    box-shadow: none;
  }

  .variant-compact:hover, .variant-horizontal:hover {
    border-color: var(--color-border-dark);
    box-shadow: none;
  }

  .variant-compact .card-content, .variant-horizontal .card-content {
    padding: 0;
  }

  .variant-compact .card-title {
    font-size: 1.125rem;
    margin-bottom: 0.35rem;
  }

  .variant-compact .card-excerpt {
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }

  @media (max-width: 860px) {
    .variant-hero {
      grid-template-columns: 1fr;
    }

    .variant-hero .card-media-wrapper {
      min-height: 200px;
      aspect-ratio: 16 / 9;
    }

    .variant-hero .card-content {
      padding: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .card-content {
      padding: 1.25rem;
    }
  }
</style>
