---
interface Props {
  userEmail?: string;
  userRole?: string;
}

const { userEmail = 'Admin', userRole = 'Administrator' } = Astro.props;
---

<header class="admin-topbar">
  <div class="topbar-inner">
    <div class="topbar-left">
      <form action="/admin/search" method="GET" class="admin-search-form">
        <input
          type="search"
          name="q"
          placeholder="Search articles, sources, research, jobs..."
          class="admin-search-input"
          aria-label="Global Admin Search"
        />
      </form>
    </div>

    <div class="topbar-right">
      <a href="/admin/review" class="header-link" title="Open Review Queue">
        <span>Review Queue</span>
      </a>
      <a href="/admin/system/health" class="header-link" title="Check System Health">
        <span>Health</span>
      </a>

      <div class="user-info">
        <span class="user-email">{userEmail}</span>
        <span class="badge badge-neutral">{userRole}</span>
      </div>

      <form action="/admin/logout" method="POST" class="logout-form">
        <button type="submit" class="btn btn-secondary btn-sm">Sign Out</button>
      </form>
    </div>
  </div>
</header>

<style>
  .admin-topbar {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 1.5rem;
  }

  .topbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .admin-search-form {
    display: flex;
    align-items: center;
  }

  .admin-search-input {
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.75rem;
    font-size: 0.8125rem;
    width: 320px;
    color: var(--color-text-main);
  }

  .admin-search-input:focus {
    outline: none;
    border-color: var(--color-accent-blue);
    background-color: var(--color-surface);
  }

  .header-link {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
  }

  .header-link:hover {
    color: var(--color-text-main);
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .user-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
  }

  .user-email {
    color: var(--color-text-main);
    font-weight: 500;
  }

  .btn-sm {
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
  }
</style>
