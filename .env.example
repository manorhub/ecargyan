# Cloudflare Workers & Astro Environment Secrets Template
# Copy this file to .dev.vars for local testing.

# 1. Runware API Key (for FLUX.1 [schnell] article image generation)
RUNWARE_API_KEY=your_runware_api_key_here

# 2. DeepSeek API Key (for editorial research and image briefing)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 3. Session & Site Secrets (Optional for local)
SESSION_SECRET=your_random_secure_session_secret
PUBLIC_SITE_URL=http://localhost:4321
ENVIRONMENT=development
