# ECargyan.com Environment Variables Template
# Copy to .env or configure via Cloudflare dashboard / wrangler secret put

# Session secret used for signing admin session cookies (Minimum 32 random characters)
SESSION_SECRET=replace-with-a-cryptographically-secure-random-string-at-least-32-chars

# Runtime Environment
ENVIRONMENT=development

# Site URL (Canonical root for SEO and URLs)
PUBLIC_SITE_URL=https://ecargyan.com

# Future Phase Credentials (Do NOT populate in Phase 1)
# DEEPSEEK_API_KEY=
